{% style %}
  th.block--{{ block.id }} {
    text-align: {{ block.settings.alignment }};
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
{% endstyle %}

<tr>
  <th class="block--{{ block.id }}" colspan="{{ block.settings.header_column_span }}" {{ block.shopify_attributes }}>
    {{ block.settings.text }}
  </th>
</tr>

{% schema %}
{
  "name": "Table Header",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "header_column_span",
      "label": "Header column span",
      "default": 1,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "type": "header",
      "content": "Styling"
    }, 
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
    ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ECECEC"
    },
  ],
  "presets": [
    {
      "name": "Table Header"
    }
  ]
}
{% endschema %}
