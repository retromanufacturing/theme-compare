{%- liquid
  assign group_items = block.settings.group_items
  assign tab_name = 'product-tabs-' | append: block.id
-%}

{%- if group_items -%}
  <div class="product-list--tabbed">
    {%- render 'element.object-tabs',
      items: block.settings.product_list,
      name: tab_name
    -%}
{%- endif -%}

{%- for product in block.settings.product_list -%}
  {%- if group_items -%}
    <div data-index="{{ forloop.index }}">
  {%- endif -%}

  {%- content_for 'block',
    type: 'custom-product-card',
    id: 'product-card',
    closest.product: product
  -%}

  {%- if group_items -%}
    </div>
  {%- endif -%}
{%- endfor -%}

{%- if group_items -%}
  </div>
{%- endif -%}

{% style %}
  .product-list--tabbed [data-index] {
    display: none;
  }

  .product-list--tabbed [data-index="1"] {
    display: block;
  }

  {% for i in (1..20) %}
    .product-list--tabbed:has(.object-tabs-wrap input[value="{{ i }}"]:checked) [data-index="{{ i }}"] {
      display: block;
    }

    .product-list--tabbed:has(.object-tabs-wrap input[value="{{ i }}"]:checked) [data-index]:not([data-index="{{ i }}"]) {
      display: none;
    }
  {% endfor %}
{% endstyle %}

{% schema %}
{
  "name": "Product List",
  "tag": null,
  "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products"
    },
    {
      "type": "checkbox",
      "id": "group_items",
      "label": "Group items",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product List",
      "blocks": {
        "product-card": {
          "type": "custom-product-card",
          "static": true,
          "settings": {
            "product": "{{ closest.product }}",
            "image_position": "left",
            "image_container_size": "medium",
            "mobile_layout": "partial"
          },
          "blocks": {
            "custom-group": {
              "type": "custom-group",
              "settings": {},
              "blocks": {
                "custom-sku": { "type": "custom-sku", "settings": {}, "blocks": {} },
                "custom-product-inventory": { "type": "custom-product-inventory", "settings": { "inventory_threshold": 10, "inventory_transfers_enable": true }, "blocks": {} }
              },
              "block_order": ["custom-sku", "custom-product-inventory"]
            },
            "custom-variant-picker": { "type": "custom-variant-picker", "settings": { "variant_labels": true, "picker_type": "button", "product_dynamic_variants_enable": true, "color_swatches": false, "update_url": false }, "blocks": {} },
            "custom-price": { "type": "custom-price", "settings": { "hide_subtitle": false, "color": "#000" }, "blocks": {} },
            "custom-product-features": { "type": "custom-product-features", "settings": { "font_size": 14 }, "blocks": {} }
          },
          "block_order": ["custom-group", "custom-variant-picker", "custom-price", "custom-product-features"]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}