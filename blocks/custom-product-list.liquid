{%- for product in block.settings.product_list -%}
  {%- content_for 'block',
    type: 'custom-product-card',
    id: 'product-card',
    closest.product: product
  -%}
{%- endfor -%}

{% schema %}
{
  "name": "Product List",
  "tag": null,
  "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products"
    }
  ],
  "presets": [
    {
      "name": "Product List",
      "blocks": {
        "product-card": {
          "type": "custom-product-card",
          "static": true,
          "settings": {
            "image_position": "left",
            "image_container_size": "medium",
            "mobile_layout": "partial"
          },
          "blocks": {
            "custom-group": {
              "type": "custom-group",
              "settings": {},
              "blocks": {
                "custom-sku": { "type": "custom-sku", "settings": {}, "blocks": {} },
                "custom-product-inventory": { "type": "custom-product-inventory", "settings": { "inventory_threshold": 10, "inventory_transfers_enable": true }, "blocks": {} }
              },
              "block_order": ["custom-sku", "custom-product-inventory"]
            },
            "custom-variant-picker": { "type": "custom-variant-picker", "settings": { "variant_labels": true, "picker_type": "button", "product_dynamic_variants_enable": true, "color_swatches": false }, "blocks": {} },
            "custom-price": { "type": "custom-price", "settings": { "hide_subtitle": false, "color": "#000" }, "blocks": {} },
            "custom-product-features": { "type": "custom-product-features", "settings": { "font_size": 14 }, "blocks": {} }
          },
          "block_order": ["custom-group", "custom-variant-picker", "custom-price", "custom-product-features"]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}