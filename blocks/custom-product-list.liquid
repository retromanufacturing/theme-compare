{%- for product in block.settings.product_list -%}
  {%- content_for 'block',
    type: 'custom-product-card',
    id: 'product-card-',
    closest.product: product
  -%}
  {{  }}
{%- endfor -%}

{% schema %}
{
  "name": "Product List",
  "tag": null,
  "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products"
    }
  ],
  "presets": [
    {
      "name": "Product List"
    }
  ]
}
{% endschema %}