{%- for product in block.settings.product_list -%}
  {{ product.title }}
  {% comment %} {%- content_for 'block',
    type: 'custom-product-card',
    id: 'static-product-card',
    closest.product: product
  -%} {% endcomment %}
{%- endfor -%}

{% schema %}
{
  "name": "Product List",
  "tag": null,
  "settings": [
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products"
    }
  ],
  "presets": [
    {
      "name": "Product List"
    }
  ]
}
{% endschema %}