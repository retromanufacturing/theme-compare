{% doc %}
  Custom variant tooltip trigger. Merchant selects a specific variant_tooltips
  metaobject entry per block instance — no automatic option-name matching,
  that logic lives in the separate variant_tooltips resolution path.

  @example
  {% content_for 'block', type: 'custom-variant-tooltip', id: 'variant-tooltip-1' %}
{% enddoc %}

{%- liquid
  assign tooltip_entry = block.settings.tooltip_list
  assign tooltip_title = tooltip_entry.name
  assign tooltip_content = tooltip_entry.text
-%}

{%- if tooltip_entry != blank -%}
  <span class="variant__label-info" {{ block.shopify_attributes }}>
    {%- render 'overlay.tool-tip.trigger',
      title: tooltip_title,
      content: tooltip_content,
      context: 'custom-variant-tooltip'
    -%}
  </span>
{%- endif -%}
{{ block.settings.tooltip_liquid }}
{% schema %}
{
  "name": "Variant Tooltip",
  "tag": null,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "tooltip_list",
      "label": "Tooltip list",
      "metaobject_type": "variant_tooltips"
    },
    {
      "type": "liquid",
      "id": "tooltip_liquid",
      "label": "Custom tooltip logic",
      "info": "Optional. If filled in, this Liquid's output becomes the tooltip content — overrides the default (first item in Tooltip list)."
    }
  ],
  "presets": [{ "name": "Variant Tooltip" }]
}
{% endschema %}
