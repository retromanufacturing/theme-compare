{%- liquid
  assign tooltip_list = block.settings.tooltip_list
  assign liquid_output = block.settings.tooltip_liquid

  if liquid_output != blank
    assign tooltip_content = liquid_output
  else
    assign tooltip_content = tooltip_list.first.text
  endif

  assign tooltip_title = tooltip_list.first.name
-%}

{%- if tooltip_content != blank -%}
  <span class="variant__label-info" {{ block.shopify_attributes }}>
    {%- render 'overlay.tool-tip.trigger',
      title: tooltip_title,
      content: tooltip_content,
      context: 'custom-variant-tooltip'
    -%}
  </span>
{%- endif -%}
{{ tooltip_list }}--{{ tooltip_list.size }}--{{ tooltip_list[0] | json }}

{% for entry in tooltip_list %}
  {{ forloop.index }}: {{ entry | json }}
{% endfor %}
{% schema %}
{
  "name": "Variant Tooltip",
  "tag": null,
  "settings": [
    {
      "type": "metaobject_list",
      "id": "tooltip_list",
      "label": "Tooltip list",
      "metaobject_type": "variant_tooltips"
    },
    {
      "type": "liquid",
      "id": "tooltip_liquid",
      "label": "Custom tooltip logic",
      "info": "Optional. If filled in, this Liquid's output becomes the tooltip content — overrides the default (first item in Tooltip list)."
    }
  ],
  "presets": [{ "name": "Variant Tooltip" }]
}
{% endschema %}