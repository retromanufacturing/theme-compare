<variant-block
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id | default: product.id }}"
  {{ block.shopify_attributes }}
>
  {% render 'block.product-features', product: closest.product | default: product, block: block %}
</variant-block>

<script type="module">
  import 'custom.variant-block'
</script>

{% schema %}
{
  "name": "Product features",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "t:custom.font_size",
      "default": 14,
      "min": 8,
      "max": 60,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "Product features" }]
}
{% endschema %}
