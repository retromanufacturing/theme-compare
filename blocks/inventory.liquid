{% style %}
  .block {
    product-inventory {
      padding-top: 0 !important;
    }
  }
{% endstyle %}

<div class="block block--{{ block.id }}" {{ block.shopify_attributes }}>
  {%- render 'product-inventory', block: block -%}
</div>

{% schema %}
{
  "name": "Inventory Status",
  "settings": [
    {
      "type": "range",
      "id": "inventory_threshold",
      "label": "t:labels.low_inventory_threshold",
      "default": 10,
      "min": 0,
      "max": 20,
      "step": 2
    },
    {
      "type": "checkbox",
      "id": "inventory_transfers_enable",
      "label": "t:actions.show_inventory_transfer",
      "info": "t:info.learn_inventory_transfers",
      "default": true
    },
    {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "inventory_in_stock",
        "label": "Inventory in stock",
        "default": "#b4fed2"
      },
      {
        "type": "color",
        "id": "inventory_in_stock_text",
        "label": "Inventory in stock text",
        "default": "#0c5132"
      },
      {
        "type": "color",
        "id": "inventory_low",
        "label": "Inventory low",
        "default": "#ffd6A4"
      },
      {
        "type": "color",
        "id": "inventory_low_text",
        "label": "Inventory low text",
        "default": "#5e4200"
      },
       {
        "type": "color",
        "id": "inventory_backordered",
        "label": "Inventory backordered",
        "default": "#ffc500"
      },
      {
        "type": "color",
        "id": "inventory_backordered_text",
        "label": "Inventory backordered text",
        "default": "#000000"
      },
  ],
  "presets": [
    {
      "name": "Inventory Status",
      "category": "Products"
    }
  ]
}
{% endschema %}
