<fitment-product-grid data-limit="{{ block.settings.product_count }}" {{ block.shopify_attributes }}>
  {%- render 'layout.section-heading', title: block.settings.heading, view_all: true, url: '#' -%}
  <div class="fitment-product-grid__results"></div>
</fitment-product-grid>

<script type="module">
  import 'custom.vehicle-search-products';
</script>

{% schema %}
{
  "name": "Fitment Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Also fits your vehicle"
    },
    {   
      "type": "range", 
      "id": "related_count", 
      "label": "Number of products", 
      "default": 6, 
      "min": 2, 
      "max": 12
    }
  ],
  "presets": [{ "name": "Fitment Product Grid" }]
}
{% endschema %}
