{%- liquid
  assign in_stock = block.settings.color_scheme_in_stock 
  assign low_stock = block.settings.color_scheme_low_stock
-%}

{% comment %} 
{{in_stock_id }}--{{ low_stock_id }}
{{  block.settings.color_scheme_in_stock }}--{{  block.settings.color_scheme_low_stock }} {% endcomment %}
{% if block.settings.enable_labels %}
<ul>  
 <li>{{  block.settings.color_scheme_in_stock.settings.primary }}</li>
 <li>{{  block.settings.color_scheme_in_stock.settings.secondary }}</li>
  <li>{{  block.settings.color_scheme_low_stock.settings.primary }}</li>
 <li>{{  block.settings.color_scheme_low_stock.settings.secondary }}</li>
  <li>Low stock: {{  block.settings.color_scheme_low_stock }}</li>
   <li>In stock: {{  block.settings.color_scheme_in_stock }}</li>
</ul>
{% endif %}

{% style %}
  .block-{{ block.id }}:has(.product-inventory__points){
    /* display: none; */
  }
  .block-{{ block.id }} .icon-and-text:not(.inventory--low) {    
    color: {{in_stock.settings.primary }};
    background-color: {{in_stock.settings.secondary }};
  
  }
{% endstyle %}

<div class="block-{{ block.id }}">
  {% render 'block.product-inventory', product: closest.product %}
</div>

{% schema %}
{
  "name": "t:labels.inventory_status",
  "settings": [
    {
      "type": "range",
      "id": "inventory_threshold",
      "label": "t:labels.low_inventory_threshold",
      "default": 10,
      "min": 0,
      "max": 20,
      "step": 2
    },
    {
      "type": "checkbox",
      "id": "inventory_transfers_enable",
      "label": "t:actions.show_inventory_transfer",
      "info": "t:info.learn_inventory_transfers",
      "default": true
    },
    {
      "type": "header",
      "content": "t:custom.custom"
    },
    {
      "type": "checkbox",
      "id": "enable_labels",
      "label": "Use inventory labels",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_in_stock",
      "label": "In stock color scheme",
      "default": "none",
      "visible_if": "{{ block.settings.enable_labels }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_low_stock",
      "label": "Low stock color scheme",
      "default": "none",
      "visible_if": "{{ block.settings.enable_labels }}"
    }
  ],
  "presets": [{ "name": "t:labels.inventory_status" }]
}
{% endschema %}
