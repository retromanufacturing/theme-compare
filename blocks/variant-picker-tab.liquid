{%- comment -%}
  Renders product variant-picker

  Accepts:
  - block {block} - Block object
  - product {product} - Product object
  - update_url {boolean} - Whether to update the URL when the variant is changed
  - swatch_style {'round'|'square'} - Swatch style

  Usage:
  {% render 'block-variant-picker', block: block %}
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product | default: product
  assign update_url = update_url | default: true, allow_false: true
  assign prev_block_index = forloop.index0 | minus: 1
  assign swatch_style = swatch_style | default: settings.swatch_style | default: 'round'
  assign product_options = block.settings.product_options | downcase
  assign variant_style = 'variant_tabs'
  assign enable_variant_info = block.settings.variants_info_enable
-%}

{%- unless product.has_only_default_variant -%}
  <block-variant-picker
    class="block-variant-picker product-block"
    id="variant-selects-{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-url="{{ product.url }}"
    {% if update_url %}
      data-update-url=""
    {% endif %}
    {% if block.settings.product_dynamic_variants_enable %}
      data-dynamic-variants-enabled=""
    {% endif %}
    data-picker-type="{{ block.settings.picker_type }}"
    data-product-id="{{ product.id }}"
    {{ block.shopify_attributes }}
  >
    
    <div class="block">
      {% for option in product.options_with_values %}     
      {%- liquid 
         assign downcased_option = option.name | downcase
         assign tab_id = block.id | append: option.name | handleize | downcase
      -%}

        {% capture tab_title %}
          <span class="variant__tab-title"> 
          {{ option.position | append: '. '  }}{{ option.name  | append: ': ' }}    

            <span class="variant__label-info">        
              <span data-variant-color-label data-option-name="{{ option.name }}">         
                {{ option.selected_value }}        
              </span>    
            </span>
            
            {% if block.settings.variant_data_enable %}
               {% render 'product-options', product: product, block: block, option: option %}
            {% endif %}         
          </span>
          {% render 'collapsible-icons' %}
        {% endcapture %}     
       
        {% capture content %}
          {%- render 'variant-button', option: option, block: block, prev_block_index: prev_block_index, variant_style: variant_style -%}          
          {% if product_options contains downcased_option %}            
            <div class="block">            
              {% content_for 'blocks' %}        
            </div>     
            {% endif %}
        {% endcapture %}
        
        {%- render 'collapsible', id: tab_id, slot_button: tab_title, slot_collapsible: content, borders: true, open: true -%}
      {% endfor %}
    </div>

    <script type="application/json">
      {{ product.variants | json }}
    </script>
  </block-variant-picker>
  <script type="module">
    import 'components/block-variant-picker'
  </script>
{%- endunless -%}

{% style %}
 .collapsible-content {
   
    .variant-button-wrap input + label:not([data-color-swatch]) {
      background-color: #EEEEEE;
      color: #555;
      margin: 0px -2px 6px 0px !important; 
    }
   
   .variant-button-wrap input:checked + label:not([data-color-swatch]) { 
      color: #555 !important;
     border: 1px solid #ddd !important;
     border-bottom: 1px solid #fff !important;
     background-color: white !important;
     box-shadow: 0 !important;
     margin: 0px -2px 6px 0px !important; 
   }  
   
 } 
 .variant__tab-title {
   color: {{ block.settings.tab_title_color}};
   font-size: {{ block.settings.tab_title_font_size}}px;
   {% if block.settings.tab_title_bold %}
     font-weight: bold;
   {% endif %}
 }
{% endstyle %}

{% schema %}
{
  "name": "Variant Picker (Tabs)",
  "blocks": [{ "type": "@theme"}, {"type": "@app"}],
  "settings": [
    {
      "type": "text",
      "id": "product_options",
      "label": "Options that will display blocks"
    },
    {         
      "type": "checkbox",          
      "id": "variants_info_enable",          
      "label": "Enable variant options info",         
      "info": "Displays additional information for variant options",
      "default": false     
    },
    {         
      "type": "checkbox",          
      "id": "product_dynamic_variants_enable",          
      "label": "t:actions.enable_dynamic_product",         
      "default": true     
    },
    {
      "type": "checkbox",
      "id": "color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.learn_to_setup_color_swatches"
    },
    {
      "type": "checkbox",
      "id": "variant_data_enable",
      "label": "Enable variant data",
      "default": false
    },
    {
      "type": "header",
      "content": "t:settings.styling"
    },
    {    
      "type": "color",
      "id": "tab_title_color",
      "label": "Title Color",
      "default": "#ffffff"    
    },
    {
      "type": "range",
      "id": "tab_title_font_size",
      "label": "Title Font Size",
      "default": 14,
      "min": 8,
      "max": 60,
      "unit": "px"
    },
    {         
      "type": "checkbox",          
      "id": "tab_title_bold",          
      "label": "Bold Title",         
      "default": false    
    },
  ],
  "presets": [
    {
      "name": "Variant Picker - tabs",
      "category": "Products"
    }
]
}
{% endschema %}
