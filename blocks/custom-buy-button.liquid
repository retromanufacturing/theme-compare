{% render 'block.product-buy-buttons', product: closest.product %}

{%- if block.settings.enable_sticky_add_to_cart -%}
  {% render 'custom.sticky-add-to-cart', product: closest.product %}
{%- endif -%}

{% schema %}
{
  "name": "t:labels.buy_buttons",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:actions.show_dynamic_checkout",
      "info": "t:info.lets_customers_checkout_familiar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "surface_pickup_enable",
      "label": "t:actions.enable_pickup_availability",
      "info": "t:actions.learn_to_setup_local_pickup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_gift_card_recipient",
      "default": false,
      "label": "t:actions.show_recipient_information",
      "info": "t:info.gift_card_products"
    },
    {
      "type": "header",
      "content": "Sticky add to cart"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "Enable sticky add to cart",
      "default": false
    },
    {
      "type": "select",
      "id": "sticky_width",
      "label": "Width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "constrained", "label": "Constrained" }
      ],
      "visible_if": "{{ block.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "text",
      "id": "position_selector",
      "label": "Position relative to element",
      "info": "Optional CSS selector, e.g. header-section or #my-element. Leave blank for default bottom-of-screen placement.",
      "visible_if": "{{ block.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "select",
      "id": "position_placement",
      "label": "Placement",
      "default": "above",
      "options": [
        { "value": "above", "label": "Above element" },
        { "value": "below", "label": "Below element" }
      ],
      "info": "Only applies when a selector is entered above.",
      "visible_if": "{{ block.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "text",
      "id": "content_push_selector",
      "label": "Push down element",
      "info": "Optional CSS selector for the element that should be pushed down to make room for the bar, when anchored below another element.",
      "default": ".page-content--product",
      "visible_if": "{{ block.settings.enable_sticky_add_to_cart }}"
    }
  ],
  "presets": [{ "name": "t:labels.buy_buttons" }]
}
{% endschema %}
