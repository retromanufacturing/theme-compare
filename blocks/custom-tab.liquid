{%- liquid
  assign product = section.settings.product | default: product
  assign title = title | default: block.settings.title
  assign is_open = block.settings.is_open
  assign tab_type = block.settings.tab_type

  for options in product.options_with_values
    if forloop.last
      assign option_count = forloop.length | plus: 1 | append: '. '
      assign option_count_2 = forloop.length | plus: 2 | append: '. '
    endif
  endfor

  capture tab_title
    case tab_type
      when 'accessories'
        assign title = block.settings.title | prepend: option_count
      when 'warranty'
        assign title = block.settings.title | prepend: option_count_2
    endcase
  endcapture

  capture accordion_content
    content_for 'blocks'
  endcapture

  capture title
    echo tab_title
  endcapture
-%}

{{ title }}--{{ tab_title }}

{%- if title != blank and accordion_content != blank -%}
  <div {{ block.shopify_attributes }}>
    {%- render 'element.accordion', title: title, slot: accordion_content, open: is_open -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Tab",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "Tab heading"
    },
    {
      "type": "checkbox",
      "id": "is_open",
      "label": "Is open",
      "default": false
    },
    {
      "type": "select",
      "id": "tab_type",
      "label": "Tab Type",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "accessories",
          "label": "Accessories"
        },
        {
          "value": "warranty",
          "label": "Warranty"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Tab", "category": "Layout" }]
}
{% endschema %}
