{% comment %}
  Inside css and content for variant labels and custom settings
{% endcomment %}

{%- liquid
  assign update_url = block.settings.update_url
-%}

{% render 'block.product-variant-picker-custom', product: closest.product, block: block, update_url: update_url  %}

{% schema %}
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "select",
      "id": "picker_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "button",
          "label": "t:labels.buttons"
        },
        {
          "value": "dropdown",
          "label": "t:labels.dropdown"
        },
        {
          "value": "button_label",
          "label": "t:custom.button_label"
        }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "product_dynamic_variants_enable",
      "label": "t:actions.enable_dynamic_product",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.learn_to_setup_color_swatches"
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "t:custom.variant_picker_update_url",
      "info": "Update product url on variant change",
      "default": true
    },
    {
      "type": "header",
      "content": "Variant labels"
    },
    {
      "type": "text",
      "id": "variant_label_options",
      "label": "Option names with variant labels",
      "info": "Comma-separated list of option names e.g. Feature Set, Motor, Choose your Look",
      "visible_if": "{{ block.settings.picker_type == 'button_label' }}"
    },
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
