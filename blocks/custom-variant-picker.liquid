{% comment %}
  Inside css and content for variant labels and custom settings
{% endcomment %}

{% render 'block.product-variant-picker', product: closest.product, block: block  %}

{% schema %}
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "checkbox",
      "id": "variant_labels",
      "label": "t:actions.show_variant_labels",
      "default": true
    },
    {
      "type": "select",
      "id": "picker_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "button",
          "label": "t:labels.buttons"
        },
        {
          "value": "dropdown",
          "label": "t:labels.dropdown"
        },
        {
          "value": "button_label",
          "label": "t:custom.button_label"
        }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "product_dynamic_variants_enable",
      "label": "t:actions.enable_dynamic_product",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.learn_to_setup_color_swatches"
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "t:custom.variant_picker_update_url",
      "info": "Update product url on variant change",
      "default": true
    },
    {
      "type": "header",
      "content": "Labels",
      "visible_if": "{{ block.settings.picker_type == 'button_label' }}"
    },
    {
      "type": "text",
      "id": "non_label_options",
      "label": "Options with no labels",
      "visible_if": "{{ block.settings.picker_type == 'button_label' }}"
    },
    {
      "type": "number",
      "id": "label_width",
      "label": "Label Width",
      "visible_if": "{{ block.settings.picker_type == 'button_label' }}"
    },
    {
      "type": "number",
      "id": "label_height",
      "label": "Label Height",
      "visible_if": "{{ block.settings.picker_type == 'button_label' }}"
    }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
