{% comment %}
  Inside css and content for variant labels and custom settings
{% endcomment %}

{%- liquid
  assign update_url = block.settings.update_url
-%}

{% style %}
  .variant-button-wrap .variant__label {
    text-transform: capitalize
  }
{% endstyle %}

{% render 'block.product-variant-picker-custom', product: closest.product, block: block, update_url: update_url %}

{% schema %}
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "checkbox",
      "id": "variant_labels",
      "label": "t:actions.show_variant_labels",
      "default": true
    },
    {
      "type": "select",
      "id": "picker_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "button",
          "label": "t:labels.buttons"
        },
        {
          "value": "dropdown",
          "label": "t:labels.dropdown"
        },
        {
          "value": "tabs",
          "label": "t:custom.tabs"
        }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "product_dynamic_variants_enable",
      "label": "t:actions.enable_dynamic_product",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.learn_to_setup_color_swatches"
    },
    {
      "type": "header",
      "content": "t:custom.custom"
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "t:custom.variant_picker_update_url",
      "info": "Update product url on variant change",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_features_and_logos",
      "label": "t:custom.actions.enable_features_and_logos"
    },
    {
      "type": "text",
      "id": "swatch_metafield_key",
      "label": "Swatch metafield key",
      "info": "Namespace and key e.g. media.variant_swatches"
    },
    {
      "type": "text",
      "id": "product_features_option_names",
      "label": "Option names that display product features",
      "visible_if": "{{ block.settings.enable_features_and_logos == true }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:custom.font_size",
      "default": 14,
      "min": 8,
      "max": 60,
      "unit": "px",
      "visible_if": "{{ block.settings.enable_features_and_logos == true }}"
    },
    {
      "type": "select",
      "id": "logo_sizing",
      "label": "Logo sizing",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default (count-based)" },
        { "value": "metaobject", "label": "Use metaobject dimensions" },
        { "value": "custom", "label": "Custom" }
      ],
      "visible_if": "{{ block.settings.enable_features_and_logos == true }}"
    },
    {
      "type": "range",
      "id": "logo_custom_height",
      "label": "Custom height (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "Only applies when sizing is set to Custom",
      "visible_if": "{{ block.settings.enable_features_and_logos == true }}"
    },
    {
      "type": "header",
      "content": "Variant labels",
      "visible_if": "{{ block.settings.enable_variant_labels }}"
    },
    {
      "type": "checkbox",
      "id": "enable_variant_labels",
      "label": "Enable variant labels",
      "default": false
    },
    {
      "type": "text",
      "id": "variant_label_options",
      "label": "Option names with variant labels",
      "info": "Comma-separated list of option names e.g. Feature Set, Motor, Choose your Look",
      "visible_if": "{{ block.settings.enable_variant_labels }}"
    },
    {
      "type": "checkbox",
      "id": "enable_colored_options",
      "label": "Enable colored options",
      "default": false,
      "visible_if": "{{ block.settings.enable_variant_labels }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_option_value_0",
      "label": "Option value 1 color scheme",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_option_value_1",
      "label": "Option value 2 color scheme",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_option_value_2",
      "label": "Option value 3 color scheme",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
