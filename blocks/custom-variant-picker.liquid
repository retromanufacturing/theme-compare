{% capture children %}
   {% content_for 'blocks' %}
{% endcapture %}

{% render 'block.product-variant-picker.custom',
  product: closest.product,
  variant_selector_type: block.settings.variant_selector_type,
  enable_tabs: block.settings.enable_tabs,
  accordion_default_open: block.settings.accordion_default_open,
  children: children
%}

{% schema %}
{
  "name": "t:custom.variant_picker_tabs",
  "blocks": [{ "type": "custom-group" }, { "type": "custom-spacer" }],
  "settings": [
    {
      "type": "select",
      "id": "variant_selector_type",
      "label": "t:labels.style",
      "default": "radio",
      "options": [
        { "value": "radio", "label": "t:labels.button" },
        { "value": "select", "label": "t:labels.dropdown" }
      ],
      "info": "t:info.variant_picker_display_options"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Display variants as tabs",
      "default": false
    },
    {
      "type": "select",
      "id": "accordion_default_open",
      "label": "Default open",
      "default": "first",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "first", "label": "First option" },
        { "value": "all", "label": "All options" }
      ],
      "visible_if": "{{ block.settings.enable_tabs }}"
    },
    {
      "type": "checkbox",
      "id": "enable_features_and_logos",
      "label": "Display product features and logos",
      "default": true
    },
    {
      "type": "header",
      "content": "Variant labels"
    },
    {
      "type": "checkbox",
      "id": "enable_variant_labels",
      "label": "Enable variant labels",
      "default": false
    },
    {
      "type": "text",
      "id": "variant_label_options",
      "label": "Option names with variant labels",
      "info": "Comma-separated list of option names e.g. Feature Set, Motor, Choose your Look",
      "visible_if": "{{ block.settings.enable_variant_labels }}"
    },
    {
      "type": "checkbox",
      "id": "enable_colored_options",
      "label": "Enable colored options",
      "default": false,
      "visible_if": "{{ block.settings.enable_variant_labels }}"
    },
    {
      "type": "color",
      "id": "color_motor_m1",
      "label": "Motor 1 color",
      "default": "#c19e44",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    },
    {
      "type": "color",
      "id": "color_motor_m2",
      "label": "Motor 2 color",
      "default": "#2e5f6e",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    },
    {
      "type": "color",
      "id": "color_motor_m4",
      "label": "Motor 4 color",
      "default": "#623f36",
      "visible_if": "{{ block.settings.enable_colored_options and block.settings.enable_variant_labels }}"
    }
  ],
  "presets": [
    {
      "name": "t:custom.variant_picker_tabs"
    }
  ]
}
{% endschema %}
