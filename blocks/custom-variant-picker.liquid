{% render 'block.product-variant-picker.custom',
  product: closest.product,
  variant_selector_type: block.settings.variant_selector_type,
  enable_tabs: block.settings.enable_tabs,
  accordion_default_open: block.settings.accordion_default_open,
%}

 {% content_for 'blocks' %}

{% schema %}
{
  "name": "t:custom.variant_picker_tabs",
  "blocks": [
    { "type": "custom-group" },
  ],
  "settings": [
    {
      "type": "select",
      "id": "variant_selector_type",
      "label": "t:labels.style",
      "default": "radio",
      "options": [
        { "value": "radio", "label": "t:labels.button" },
        { "value": "select", "label": "t:labels.dropdown" }
      ],
      "info": "t:info.variant_picker_display_options"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Display variants as tabs",
      "default": false
    },
    {
      "type": "select",
      "id": "accordion_default_open",
      "label": "Default open",
      "default": "first",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "first", "label": "First option" },
        { "value": "all", "label": "All options" }
      ],
      "visible_if": "{{ block.settings.enable_tabs }}"
    },
    {
      "type": "checkbox",
      "id": "enable_features_and_logos",
      "label": "Display product features and logos",
      "default": true
    },
    {
      "type": "header",
      "content": "Features and logos settings",
      "visible_if": "{{ block.settings.enable_features_and_logos }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:custom.font_size",
      "default": 14,
      "min": 8,
      "max": 60,
      "unit": "px",
      "visible_if": "{{ block.settings.enable_features_and_logos }}"
    },
    {
      "type": "select",
      "id": "logo_sizing",
      "label": "Logo sizing",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default (count-based)" },
        { "value": "metaobject", "label": "Use metaobject dimensions" },
        { "value": "custom", "label": "Custom" }
      ],
      "visible_if": "{{ block.settings.enable_features_and_logos }}"
    },
    {
      "type": "range",
      "id": "logo_custom_height",
      "label": "Logo custom height (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "Only applies when sizing is set to Custom",
      "visible_if": "{{ block.settings.enable_features_and_logos }}"
    }
  ],
  "presets": [
    {
      "name": "t:custom.variant_picker_tabs"
    }
  ]
}
{% endschema %}
