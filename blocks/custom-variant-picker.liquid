{%- liquid
  assign custom_settings = block.settings.enable_custom_settings

  capture variant_picker
    if custom_settings
      render 'custom.block.product-variant-picker', block: block, product: closest.product
    else
      render 'block.product-variant-picker', block: block, product: closest.product
    endif
  endcapture

  if variant_picker != blank
    echo variant_picker
  endif
-%}

{% schema %}
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "checkbox",
      "id": "variant_labels",
      "label": "t:actions.show_variant_labels",
      "default": true
    },
    {
      "type": "select",
      "id": "picker_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "button",
          "label": "t:labels.buttons"
        },
        {
          "value": "dropdown",
          "label": "t:labels.dropdown"
        }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.learn_to_setup_color_swatches"
    },
    {
      "type": "text",
      "id": "size_chart_option",
      "label": "t:actions.attach_size_chart",
      "info": "t:info.attach_size_chart"
    },
    {
      "type": "page",
      "id": "size_chart",
      "label": "t:labels.size_chart_page"
    },
    {
      "type": "header",
      "content": "t:custom.custom"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_settings",
      "label": "Enable custom settings"
    },
    {
      "type": "text",
      "id": "size_chart_label",
      "label": "Size chart label",
      "default": "Size chart",
      "visible_if": "{{ block.settings.enable_custom_settings }}"
    },
    {
      "type": "metaobject_list",
      "id": "variant_swatches",
      "label": "Variant swatches",
      "metaobject_type": "variant_swatches",
      "info": "Applies to variants not assigned to Color swatches. Only works if custom settings enabled"
    },
    {
      "type": "checkbox",
      "id": "enable_variant_details",
      "label": "Show colored variant detail buttons",
      "info": "Renders matching option values as colored buttons with details pulled from that variant's matching metaobject, instead of plain text.",
      "default": false,
      "visible_if": "{{ block.settings.enable_custom_settings }}"
    },
    {
      "type": "text",
      "id": "variant_details_options",
      "label": "Option name(s) to apply this to",
      "info": "Comma-separated option name(s) that should use variant details styling (e.g. 'Feature Set'). Other options like Size or Color are left as plain buttons.",
      "visible_if": "{{ block.settings.enable_custom_settings }}"
    }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
