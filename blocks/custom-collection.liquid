{%- for product in block.settings.collection.products -%}
  {%- content_for 'block',
    type: 'custom-product-card',
    id: 'product-card',
    closest.product: product
  -%}
{%- endfor -%}

{% schema %}
{
  "name": "Collection",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Collection"
    }
  ]
}
{% endschema %}