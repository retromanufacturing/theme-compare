    "rich_text_tFDpbU": {
      "type": "rich-text",
      "blocks": {
        "heading_hYkciq": {
          "type": "heading",
          "settings": {
            "title": "Awards and Accolades",
            "heading_size": "h2"
          }
        },
        "text_hnFVJ3": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>We're deeply appreciative of the industry accolades we have received. They stand as a testament to our dedication to developing great products and our passion for exceptional audio. The overwhelming support from the restoration community fills us with immense gratitude and drives us to continuously push the boundaries of innovation creating products for the restoration community.</p>"
          }
        }
      },
