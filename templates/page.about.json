    "advanced_content_jmUDzX": {
      "type": "advanced-content",
      "blocks": {
        "liquid_K7VHBw": {
          "type": "liquid",
          "settings": {
            "code": "<h2><b>Officially Licensed Products</b></h2>\n<p>Retro Manufacturing offers many officially licensed products for Ford, GM, and Mopar restorations to provide an authentic look in your classic vehicle.</p>",
            "width": "50%",
            "alignment": "center"
          }
        },
        "image_DRrAxK": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/OfficiallyLicensedProducts.jpg",
            "link": "",
            "width": "50%",
            "alignment": "center"
          }
        },
        "image_9FREtW": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/Communities.jpg",
            "link": "",
            "width": "50%",
            "alignment": "center"
          }
        },
        "liquid_pgmixX": {
          "type": "liquid",
          "settings": {
            "code": "<h2><b>Community</b></h2>\nRetro Manufacturing is a proud member of SEMA, ARMO and the restoration community. We love working with local builders and restoration shops and seeing our products represented in your builds. For more information, please submit a sponsorship request.\n\nWe are located in Henderson, Nevada, and are also members of the Henderson Chamber of Commerce. We strongly believe in supporting your local community and passionately support local charities. We often donate to organizations in support of local kids, Veterans, and first responders. If you're working on an important project, contact us if there is something we can do to help.",
            "width": "50%",
            "alignment": "center"
          }
        }
      },
      "block_order": [
