          }
        },
        "liquid_UNg6Wm": {
          "type": "liquid",
          "settings": {
            "code": "<p>RetroSound radios are the most technologically advanced car stereo available for classic cars and trucks. With updated features like the latest Bluetooth®, SiriusXM-Ready®, made-for-iPhone/iPod, USB, RCA outputs, and more, RetroSound brand radios transform your classic car into your favorite daily driver! To take your listening experience to the next level, RetroSound speakers, kick panels, and accessories cover everything you need for a top-quality stereo system.</p>",
            "width": "75%",
            "alignment": "center"
          }
