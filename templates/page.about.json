          "settings": {
            "title": "Our Vision",
            "heading_size": "h2"
          }
        },
        "text_D3TK9C": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>At Retro Manufacturing, we are dedicated to preserving the timeless essence of classic vehicles while seamlessly integrating cutting-edge audio technology. Our mission is to provide enthusiasts with unparalleled audio solutions that enhance their driving experience, embodying the perfect fusion of nostalgia and innovation.</p>"
          }
