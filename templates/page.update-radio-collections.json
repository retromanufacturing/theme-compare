e=\"col\">Motor 2B</th>\n              <th scope=\"col\">Motor 4HD</th>\n            </tr>\n          </thead>\n\n          <tbody>\n            <tr>\n              <td>Feature level</td>\n              <td>Essential</td>\n              <td>\n                <span class=\"rs-badge\">Most Popular</span><br>\n                Expanded connectivity\n              </td>\n              <td>Flagship</td>\n            </tr>\n\n            <tr>\n              <td>Bluetooth®</td>\n              <td>Yes</td>\n              <td>Yes</td>\n              <td>Bluetooth® 5.0</td>\n            </tr>\n\n            <tr>\n              <td>USB</td>\n              <td>No</td>\n              <td>Yes</td>\n              <td>Dual USB ports</td>\n            </tr>\n\n            <tr>\n              <td>Display illumination</td>\n              <td>White</td>\n              <td>Adjustable color</td>\n              <td>Adjustable color</td>\n            </tr>\n\n            <tr>\n              <td>HD Radio®</td>\n              <td>No</td>\n              <td>No</td>\n              <td>Yes</td>\n            </tr>\n\n            <tr>\n              <td>SiriusXM® ready</td>\n              <td>No</td>\n              <td>No</td>\n              <td>Yes</td>\n            </tr>\n\n            <tr>\n              <td>RetroSound Radio App</td>\n              <td>No</td>\n              <td>No</td>\n              <td>Yes</td>\n            </tr>\n\n            <tr>\n              <td>Best suited for</td>\n              <td>Essential Bluetooth audio</td>\n              <td>Expanded classic car audio systems</td>\n              <td>Premium features and app-based control</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"rs-btn-row\">\n        <a\n          class=\"rs-btn rs-btn-primary\"\n          href=\"/pages/retrosound-radio-motors\"\n        >\n          View Complete Motor Details\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- APP INFORMATION -->\n\n  <section class=\"rs-section rs-section-light\">\n    <div class=\"rs-container rs-two-col\">\n\n      <div class=\"rs-info-image\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/990-RR-app.jpg?v=1785879541\"\n          alt=\"RetroSound Radio App shown on a smartphone\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div>\n        <p class=\"rs-eyebrow\">App-Enabled Control</p>\n\n        <h2 class=\"rs-h2\">\n          Control Compatible Radios from Your Smartphone\n        </h2>\n\n        <p class=\"rs-copy\">\n          The Motor 4HD platform supports the RetroSound Radio App, allowing\n          compatible radios to be controlled and configured from a smartphone\n          through Bluetooth®.\n        </p>\n\n        <ul class=\"rs-info-list\">\n          <li>Select audio sources and radio presets</li>\n          <li>Adjust EQ, crossover, and subwoofer settings</li>\n          <li>Customize display colors</li>\n          <li>Control volume, balance, and fader</li>\n          <li>Configure additional radio preferences</li>\n        </ul>\n\n        <div class=\"rs-btn-row\">\n          <a\n            class=\"rs-btn rs-btn-primary\"\n            href=\"/pages/retrosound-radio-control-app-information\"\n          >\n            Learn About the RetroSound Radio App\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- WHY RETROSOUND -->\n\n  <section class=\"rs-why2-section\" aria-labelledby=\"rs-why2-main-title\">\n    <div class=\"rs-container\">\n      <div class=\"rs-why2-header\">\n        <p class=\"rs-eyebrow\">Why RetroSound?</p>\n        <h2 id=\"rs-why2-main-title\" class=\"rs-h2\">Designed for Classic Vehicles</h2>\n        <p class=\"rs-copy\">RetroSound radios preserve the character of your classic dashboard while providing the modern features, fitment options, and installation support needed for a successful upgrade.</p>\n      </div>\n\n      <div class=\"rs-why2-grid\">\n        <article class=\"rs-why2-card\">\n          <div class=\"rs-why2-image\">\n            <!-- Replace with: <img src=\"YOUR-IMAGE-URL\" alt=\"RetroSound radio installed in a period-style classic vehicle dashboard\" width=\"900\" height=\"675\" loading=\"lazy\"> -->\n            <div class=\"rs-why2-placeholder\">Classic Style, Modern Sound Illustration<br>900 × 675</div>\n          </div>\n          <div class=\"rs-why2-body\">\n            <div class=\"rs-why2-heading\"><div class=\"rs-why2-icon\" aria-hidden=\"true\">✦</div><h3 class=\"rs-why2-title\">Classic Style. Modern Sound.</h3></div>\n            <p class=\"rs-why2-text\">Retain the original look of your dashboard while adding Bluetooth, USB, HD Radio, SiriusXM capability, customizable display options, and more.</p>\n            <div class=\"rs-why2-stat\">Factory-Inspired Appearance</div>\n          </div>\n        </article>\n\n        <article class=\"rs-why2-card\">\n          <div class=\"rs-why2-image\">\n            <!-- Replace with: <img src=\"YOUR-IMAGE-URL\" alt=\"Classic cars and trucks representing RetroSound vehicle applications\" width=\"900\" height=\"675\" loading=\"lazy\"> -->\n            <div class=\"rs-why2-placeholder\">Designed for Your Classic Illustration<br>900 × 675</div>\n          </div>\n          <div class=\"rs-why2-body\">\n            <div class=\"rs-why2-heading\"><div class=\"rs-why2-icon\" aria-hidden=\"true\">▣</div><h3 class=\"rs-why2-title\">Designed for Your Classic.</h3></div>\n            <p class=\"rs-why2-text\">RetroSound offers solutions for classic cars and trucks from the 1940s through the 1990s, with vehicle-specific components designed for a clean, factory-inspired fit.</p>\n            <div class=\"rs-why2-stat\">More Than 1,000 Applications</div>\n          </div>\n        </article>\n\n        <article class=\"rs-why2-card\">\n          <div class=\"rs-why2-image\">\n            <!-- Replace with: <img src=\"YOUR-IMAGE-URL\" alt=\"RetroSound radio motor, face, knob, and display options\" width=\"900\" height=\"675\" loading=\"lazy\"> -->\n            <div class=\"rs-why2-placeholder\">Build Your Radio Illustration<br>900 × 675</div>\n          </div>\n          <div class=\"rs-why2-body\">\n            <div class=\"rs-why2-heading\"><div class=\"rs-why2-icon\" aria-hidden=\"true\">☷</div><h3 class=\"rs-why2-title\">Build the Radio That’s Right for You.</h3></div>\n            <p class=\"rs-why2-text\">Choose the motor, face style, knobs, and display options that fit your vehicle and your build. Select the appearance and modern features that matter most to you.</p>\n            <div class=\"rs-why2-stat\">Multiple Styles and Feature Packages</div>\n          </div>\n        </article>\n\n        <article class=\"rs-why2-card\">\n          <div class=\"rs-why2-image\">\n            <!-- Replace with: <img src=\"YOUR-IMAGE-URL\" alt=\"RetroSound mounting kit, wiring harness, speaker, and installation guide\" width=\"900\" height=\"675\" loading=\"lazy\"> -->\n            <div class=\"rs-why2-placeholder\">Everything You Need Illustration<br>900 × 675</div>\n          </div>\n          <div class=\"rs-why2-body\">\n            <div class=\"rs-why2-heading\"><div class=\"rs-why2-icon\" aria-hidden=\"true\">⚙</div><h3 class=\"rs-why2-title\">Everything You Need to Get Started.</h3></div>\n            <p class=\"rs-why2-text\">Vehicle-specific installation accessories, detailed guides, wiring information, and knowledgeable support help make upgrading your classic more straightforward.</p>\n            <div class=\"rs-why2-stat\">Parts, Guidance, and Support</div>\n          </div>\n        </article>\n      </div>\n\n      <article class=\"rs-why2-panel\">\n        <div class=\"rs-why2-panel-image\">\n          <!-- Replace with: <img src=\"YOUR-IMAGE-URL\" alt=\"RetroSound support process from radio selection through finished installation\" width=\"1600\" height=\"650\" loading=\"lazy\"> -->\n          <div class=\"rs-why2-placeholder\">We’ve Thought of Everything Process Illustration<br>1600 × 650</div>\n        </div>\n        <div class=\"rs-why2-panel-copy\">\n          <p class=\"rs-eyebrow\">Support from Start to Finish</p>\n          <h3 class=\"rs-why2-panel-title\">We’ve Thought of Everything.</h3>\n          <p class=\"rs-why2-panel-text\">From selecting the right fitment through final installation, RetroSound provides the components, information, and expert assistance needed to complete your audio upgrade with confidence.</p>\n          <ul class=\"rs-why2-list\">\n            <li>Vehicle-specific radio and mounting solutions</li>\n            <li>Wiring harnesses and installation accessories</li>\n            <li>Detailed product and installation guides</li>\n            <li>Knowledgeable customer and technical support</li>\n          </ul>\n          <a class=\"rs-why2-link\" href=\"https://help.retromanufacturing.com/\">Explore Installation Resources →</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n\n  <!-- FAQ -->\n\n  <section class=\"rs-section rs-section-light rs-faq\">\n    <div class=\"rs-container\">\n\n      <div class=\"rs-content-width\">\n        <p class=\"rs-eyebrow\">Frequently Asked Questions</p>\n\n        <h2 class=\"rs-h2\">\n          Choosing a Classic Car Radio\n        </h2>\n      </div>\n\n      <details>\n        <summary>What is RetroRadio?</summary>\n        <p>\n          RetroRadio is the original configurable RetroSound radio system. Its\n          adjustable shaft-style design supports more than 1,000 classic car\n          and truck applications and allows you to select the radio face,\n          knobs, trim, and motor.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          How is RetroRadio different from other RetroSound shaft-style radios?\n        </summary>\n        <p>\n          RetroRadio is a broad-application configurable system. Other\n          RetroSound shaft-style radios are designed around more specific\n          vehicle makes, models, years, or factory dash styles.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          What is the difference between a shaft-style radio and a DIN radio?\n        </summary>\n        <p>\n          Shaft-style radios are designed for dash openings that position\n          control shafts on each side of the radio display. Single DIN radios\n          fit a standardized rectangular opening commonly found in modified\n          dashboards and many European vehicles.\n        </p>\n      </details>\n\n      <details>\n        <summary>Which radio is best for a modified dashboard?</summary>\n        <p>\n          A radio from the DIN Solutions collection is generally the most\n          appropriate option for a classic vehicle that has been modified with\n          a standard Single DIN opening.\n        </p>\n      </details>\n\n      <details>\n        <summary>What does the RetroSound radio motor control?</summary>\n        <p>\n          The radio motor determines the radio's feature set, including\n          Bluetooth®, USB connectivity, display options, amplifier outputs,\n          HD Radio®, SiriusXM® readiness, and app compatibility.\n        </p>\n      </details>\n\n      <details>\n        <summary>Which RetroSound motors support the app?</summary>\n        <p>\n          The Motor 4HD and Motor 4DAB platforms support the RetroSound Radio\n          App.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          Can a RetroSound radio add Bluetooth without changing the classic look?\n        </summary>\n        <p>\n          Yes. RetroSound radios combine classic-inspired faces and controls\n          with modern audio features such as Bluetooth®, USB, HD Radio®, and\n          compatible app-based control.\n        </p>\n      </details>\n\n    </div>\n  </section>\n\n\n  <!-- FINAL CTA -->\n\n  <section class=\"rs-final-cta\">\n    <div class=\"rs-container\">\n      <h2 class=\"rs-h2\">Find the Right Radio for Your Classic</h2>\n      <p class=\"rs-copy\">\n        Explore the configurable RetroRadio system, vehicle-specific radiocollections, DIN Solutions, and specialty radio formats designed for classic vehicles.\n      </p>\n\n      <div class=\"rs-btn-row\">\n        <a class=\"rs-btn rs-btn-primary\" href=\"/collections/radios\">View All Radios</a>\n        <a class=\"rs-btn rs-btn-secondary\" href=\"/collections/build-your-own-radio\">Build a RetroRadio</a>\n        <a class=\"rs-btn rs-btn-secondary\" href=\"/collections/din-radios\">Explore DIN Solutions</a>\n      </div>\n\n    </div>\n  </section>\n</div>",
