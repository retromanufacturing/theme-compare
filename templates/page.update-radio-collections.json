ify-content: center; border-radius: 50%; background: var(--rs-red); color: var(--rs-white); font-size: 21px; font-weight: 800; }\n  .rs-why2-title { margin: 0; font-size: 23px; font-weight: 800; line-height: 1.15; }\n  .rs-why2-text { margin: 0; color: var(--rs-muted); font-size: 15.5px; line-height: 1.58; }\n  .rs-why2-stat { margin-top: auto; padding-top: 20px; color: var(--rs-red); font-size: 13px; font-weight: 800; letter-spacing: .04em; line-height: 1.4; text-transform: uppercase; }\n  .rs-why2-panel { display: grid; grid-template-columns: minmax(0,1.55fr) minmax(280px,.75fr); gap: 34px; align-items: center; margin-top: 22px; padding: 30px; border: 1px solid var(--rs-border); border-radius: var(--rs-radius); background: var(--rs-white); box-shadow: 0 7px 22px rgba(0,0,0,.06); }\n  .rs-why2-panel-image { display: flex; min-width: 0; min-height: 260px; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px; background: var(--rs-light); }\n  .rs-why2-panel-image img { display: block; width: 100%; height: auto; object-fit: contain; }\n  .rs-why2-panel-copy { min-width: 0; }\n  .rs-why2-panel-title { margin: 0 0 14px; font-size: clamp(27px,3vw,38px); font-weight: 800; line-height: 1.1; }\n  .rs-why2-panel-text { margin: 0 0 22px; color: var(--rs-muted); font-size: 16px; line-height: 1.6; }\n  .rs-why2-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }\n  .rs-why2-list li { position: relative; padding-left: 20px; color: var(--rs-text); font-size: 14px; font-weight: 700; line-height: 1.4; }\n  .rs-why2-list li::before { position: absolute; top: .68em; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--rs-red); content: \"\"; transform: translateY(-50%); }\n  .rs-why2-link { display: inline-block; margin-top: 24px; color: var(--rs-red); font-size: 15px; font-weight: 800; text-decoration: none; }\n  .rs-why2-link:hover, .rs-why2-link:focus-visible { color: var(--rs-red-dark); text-decoration: underline; }\n  @media (max-width: 1100px) { .rs-why2-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .rs-why2-panel { grid-template-columns: 1fr; } }\n  @media (max-width: 620px) { .rs-why2-section { padding: 50px 18px; } .rs-why2-grid { grid-template-columns: 1fr; } .rs-why2-body { padding: 21px; } .rs-why2-title { font-size: 22px; } .rs-why2-panel { gap: 24px; padding: 22px; } .rs-why2-panel-image { min-height: 210px; } }\n\n</style>\n\n<div class=\"rs-radio-page\">\n\t<!-- HERO -->\n\n  <section class=\"rs-hero\">\n    <div class=\"rs-container rs-hero-grid\">\n\n      <div>\n        <p class=\"rs-eyebrow\">RetroSound Radios</p>\n\n        <h1 class=\"rs-h1\">\n          Classic Car Radios with Modern Sound\n        </h1>\n\n        <p class=\"rs-copy\">\n          RetroSound radios are designed specifically for classic cars and\n          trucks, combining period-correct styling with modern features such\n          as Bluetooth®, USB, HD Radio®, SiriusXM® readiness, and app-based\n          control.\n        </p>\n\n<div class=\"rs-next-step\">\n\n  <div class=\"rs-next-option\">\n    <h3 class=\"rs-h3\" style=\"margin-bottom:10px;\">Know Your Vehicle?</h3>\n    <p class=\"rs-copy\">Use the <strong>Make, Model &amp; Year</strong> finder above to quickly locate the RetroSound radios designed to fit your classic vehicle.</p>\n  </div>\n  <div class=\"rs-next-divider\">\n    <span>-OR-</span>\n  </div>\n  <div class=\"rs-next-option\">\n    <h3 class=\"rs-h3\" style=\"margin-bottom:10px;\">Not Sure Which Model Is Right?</h3>\n    <p class=\"rs-copy\">Continue below to compare radio styles, learn about key features, and discover which RetroSound model best matches your vehicle and restoration goals.</p>\n    <a class=\"rs-btn rs-btn-primary\" href=\"#designed-for-classic-vehicles\">Compare Radio Models ↓</a>\n  </div>\n\n</div>\n      </div>\n\n      <div class=\"rs-hero-image\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/1440x900-rr-title.jpg?v=1785882452\"\n          alt=\"RetroSound classic car radio collection\"\n          width=\"1400\"\n          height=\"900\"\n          loading=\"eager\"\n        >\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- CATEGORY GUIDE -->\n  <section id=\"designed-for-classic-vehicles\" class=\"rs-section\">\n    <div class=\"rs-container\">\n\n      <div class=\"rs-content-width\">\n        <p class=\"rs-eyebrow\">Start Here</p>\n\n        <h2 class=\"rs-h2\">\n          Find the Right Radio for Your Dash\n        </h2>\n\n        <p class=\"rs-copy\">\n          RetroSound offers several radio formats for different dash openings\n          and vehicle applications. Start by choosing the category that best\n          describes your vehicle and installation.\n        </p>\n      </div>\n\n      <div class=\"rs-category-grid\">\n        <article class=\"rs-category-card\">\n          <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/retroradio\"\n            aria-label=\"Learn about RetroRadio\">\n            <img\n              class=\"rs-category-image\"\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/700x525-radio-rr-10-blackjpg.jpg?v=1785881897\"\n              alt=\"Configurable RetroSound RetroRadio for classic vehicles\"\n              width=\"700\"\n              height=\"525\"\n              loading=\"lazy\">\n          </a>\n\n          <div class=\"rs-category-body\">\n            <h3 class=\"rs-h3\">RetroRadio</h3>\n            <p>\n              The original configurable RetroSound radio system, designed for\n              more than 1,000 classic car and truck applications.\n            </p>\n\n            <ul class=\"rs-category-list\">\n              <li>Adjustable shaft-style configuration</li>\n              <li>Choose the face, knobs, trim, and motor</li>\n              <li>Broad classic vehicle coverage</li>\n            </ul>\n\n            <a class=\"rs-category-cta\" href=\"https://www.retromanufacturing.com/collections/retroradio\">Explore RetroRadios</a>\n          </div>\n        </article>\n\n\n        <article class=\"rs-category-card\">\n          <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/pages/radios\"\n            aria-label=\"Explore vehicle-specific RetroSound radios\"\n          >\n            <img\n              class=\"rs-category-image\"\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/700x525-radio-montery.jpg?v=1785883230\"\n              alt=\"Vehicle-specific RetroSound shaft-style radios\"\n              width=\"700\"\n              height=\"525\"\n              loading=\"lazy\"\n            >\n          </a>\n\n          <div class=\"rs-category-body\">\n            <h3 class=\"rs-h3\">Specialty Radios</h3>\n\n            <p>\n              Shaft-style radios designed around particular makes, models, and\n              factory dash layouts for a more application-specific appearance.\n            </p>\n\n            <ul class=\"rs-category-list\">\n              <li>Make and model-focused designs</li>\n              <li>Factory-inspired face styling</li>\n              <li>Modern RetroSound motor options</li>\n            </ul>\n\n            <a class=\"rs-category-cta\" href=\"https://www.retromanufacturing.com/pages/radios\">Explore Specialty Radios</a>\n          </div>\n        </article>\n\n        <article class=\"rs-category-card\">\n          <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/din-radios\"\n            aria-label=\"Explore RetroSound DIN Solutions\"\n          >\n            <img\n              class=\"rs-category-image\"\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/700x525-radio-liberty.jpg?v=1785883489\"\n              alt=\"RetroSound DIN Solutions classic car radios\"\n              width=\"700\"\n              height=\"525\"\n              loading=\"lazy\"\n            >\n          </a>\n\n          <div class=\"rs-category-body\">\n            <h3 class=\"rs-h3\">DIN Solutions</h3>\n\n            <p>\n              Period-inspired Single DIN radios for modified classic car\n              dashboards and European vehicles with standard DIN openings.\n            </p>\n\n            <ul class=\"rs-category-list\">\n              <li>Standard Single DIN installation</li>\n              <li>Low-profile, period-inspired faces</li>\n              <li>American and European styling options</li>\n            </ul>\n\n            <a class=\"rs-category-cta\" href=\"https://www.retromanufacturing.com/collections/din-radios\">Explore DIN Solutions</a>\n          </div>\n        </article>\n\n        <article class=\"rs-category-card\">\n          <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/1-5-din-radios\"\n            aria-label=\"Explore RetroSound 1.5 DIN radios\"\n          >\n            <img\n              class=\"rs-category-image\"\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/700x525-radio-newport.jpg?v=1785883489\"\n              alt=\"RetroSound 1.5 DIN radios for classic GM vehicles\"\n              width=\"700\"\n              height=\"525\"\n              loading=\"lazy\"\n            >\n          </a>\n\n          <div class=\"rs-category-body\">\n            <h3 class=\"rs-h3\">1.5 DIN Radios</h3>\n\n            <p>\n              Specialty radio faces for select vehicles equipped with larger\n              factory 1.5 DIN radio openings.\n            </p>\n\n            <ul class=\"rs-category-list\">\n              <li>Designed for select factory openings</li>\n              <li>Application-focused styling</li>\n              <li>Modern features without a generic appearance</li>\n            </ul>\n\n            <a class=\"rs-category-cta\" href=\"https://www.retromanufacturing.com/collections/1-5-din-radios\">Explore 1.5 DIN Radios</a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n\n  <!-- RETRORADIO INFORMATION -->\n\n  <section class=\"rs-section rs-section-light\">\n    <div class=\"rs-container\">\n\n      <div class=\"rs-two-col\">\n\n        <div>\n          <p class=\"rs-eyebrow\">Original Configurable System</p>\n\n          <h2 class=\"rs-h2\">\n            RetroRadio: The Original Configurable Classic Car Radio\n          </h2>\n\n          <p class=\"rs-copy\">\n            RetroRadio is the original configurable RetroSound radio platform.\n            Its adjustable shaft-style design supports more than 1,000 classic\n            car and truck applications while preserving the appearance of an\n            original radio opening.\n          </p>\n\n          <p class=\"rs-copy\">\n            RetroRadio allows you to select the radio face, knobs, trim, and\n            radio motor that best match your vehicle and preferred feature\n            set. It is the broad-application option within the RetroSound radio\n            lineup.\n          </p>\n\n          <div class=\"rs-btn-row\">\n            <a class=\"rs-btn rs-btn-primary\" href=\"https://www.retromanufacturing.com/collections/retroradio\">Shop RetroRadio Models</a>\n\n            <a class=\"rs-btn rs-btn-secondary\" href=\"https://www.retromanufacturing.com/products/retroradio-build-your-own-radio\">Build Custom RetroRadio</a>\n          </div>\n        </div>\n\n        <div class=\"rs-info-image\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/990-RR-components-faces.jpg?v=1785963053\"\n            alt=\"Configurable RetroRadio face, knobs, trim, and radio motor\"\n            loading=\"lazy\"\n          >\n        </div>\n\n      </div>\n\n      <div class=\"rs-mini-grid\">\n\n        <div class=\"rs-mini-card\">\n          <h3 class=\"rs-h3\">Choose a Look</h3>\n          <p>\n            Find the perfect fit for your vehicle with our Year, Make, Model Selector or Build Your Own by selecting a radio face, trim, and knob set that complement the era and design of your classic vehicle.\n          </p>\n        </div>\n\n        <div class=\"rs-mini-card\">\n          <h3 class=\"rs-h3\">Select a Feature Set</h3>\n          <p>\n            Choose a radio motor based on the connectivity, audio features,\n            display options, and controls that matter to you.\n          </p>\n        </div>\n\n        <div class=\"rs-mini-card\">\n          <h3 class=\"rs-h3\">Get a Factory-Like Fit</h3>\n          <p>\n            RetroSound's adjustable mounting system helps position the radio\n            within a wide range of original classic vehicle dash openings.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- VEHICLE-SPECIFIC INFORMATION -->\n\n  <section class=\"rs-section\">\n    <div class=\"rs-container rs-two-col\">\n\n      <div class=\"rs-info-image\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/990-specialty-faces-multi.jpg?v=1785961624\"\n          alt=\"Examples of vehicle-specific RetroSound radios\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div>\n        <p class=\"rs-eyebrow\">Application-Focused Designs</p>\n\n        <h2 class=\"rs-h2\">\n          Vehicle-Specific RetroSound Radios\n        </h2>\n\n        <p class=\"rs-copy\">\n          In addition to RetroRadio, RetroSound offers shaft-style radios\n          designed around particular makes, models, and factory dash layouts.\n          These radios use similar RetroSound technology but feature faces,\n          controls, and proportions developed for more specific applications.\n        </p>\n\n        <p class=\"rs-copy\">\n          Popular examples include the Wonder Bar for select mid-1950s\n          Chevrolet applications, the Santa Cruz for classic Ford vehicles,\n          and other collections developed for Chevrolet and GMC trucks,\n          Mustangs, Mopar vehicles, and additional American classics.\n        </p>\n\n        <div\n          class=\"rs-model-callouts\"\n          aria-label=\"Examples of vehicle-specific RetroSound radio collections\"\n        >\n          <a class=\"rs-model-callout\" href=\"https://www.retromanufacturing.com/collections/wonderbar\" > Wonder Bar </a>\n          <a class=\"rs-model-callout\" href=\"https://www.retromanufacturing.com/collections/santa-cruz\" > Santa Cruz </a>\n          <a class=\"rs-model-callout\" href=\"https://www.retromanufacturing.com/collections/huntington\" > Huntington </a>\n          <a class=\"rs-model-callout\" href=\"https://www.retromanufacturing.com/collections/apache\" > Apache </a>\n          <a class=\"rs-model-callout\" href=\"https://www.retromanufacturing.com/collections/retrosound-dallas-radio\" > Dallas </a>\n        </div>\n\n        <p class=\"rs-copy\">\n          Because these radios are designed for narrower groups of vehicles,\n          use the vehicle search or the radio collection to confirm the\n          appropriate model for your year, make, and model.\n        </p>\n\n        <div class=\"rs-btn-row\">\n          <a class=\"rs-btn rs-btn-primary\" href=\"/collections/radios\">View Vehicle-Specific Radios</a>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- DIN SOLUTIONS INFORMATION -->\n\n  <section class=\"rs-section rs-section-dark\">\n<div class=\"rs-container\">\n\n  <div class=\"rs-intro-grid\">\n    <div class=\"rs-intro-copy\">\n      <p class=\"rs-eyebrow\">DIN Solutions</p>\n      <h2 class=\"rs-h2\">Period-Inspired Radios for Single DIN Openings</h2>\n      <p class=\"rs-copy\">\n        Many classic vehicles have been modified with aftermarket Single DIN\n        radio openings. Other vehicles, particularly European models, were\n        originally designed around a DIN-format radio. RetroSound DIN\n        Solutions provide a more period-appropriate alternative to a generic\n        modern stereo.\n      </p>\n    </div>\n    <figure class=\"rs-intro-image\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/1440x900-DIN-demo.jpg?v=1785955345\"\n        alt=\"RetroSound DIN Solutions radio installed in a classic vehicle\"\n\t\t width=\"600\"\n         height=\"450\"\n        loading=\"lazy\"\n      >\n      <figcaption>\n        <strong>Single DIN</strong> opening on a classic GM Dash.\n      </figcaption>\n    </figure>\n  </div>\n\n      <div class=\"rs-din-grid\">\n        <article class=\"rs-din-item\">\n          <div class=\"rs-din-image\">\n\t       <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/retrosound-liberty-radio\"\n            aria-label=\"Learn about Din Solutions Liberty Radio\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/600x450-liberty-hero.jpg?v=1785959439\"\n              alt=\"RetroSound Liberty DIN radio\"\n              width=\"600\"\n              height=\"450\"\n              loading=\"lazy\"\n            >\n\t\t\t  </a>\n          </div>\n          <div class=\"rs-din-content\">\n            <h3>Liberty</h3>\n            <p>\n              A low-profile DIN solution developed for modified American classic\n              car and truck dashboards.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rs-din-item\">\n          <div class=\"rs-din-image\">\n\t\t\t<a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/retrosound-europa-radio\"\n            aria-label=\"Learn about Din Solutions Europa Radio\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/600x450-europa-hero.jpg?v=1785959439\"\n              alt=\"RetroSound Europa DIN radio\"\n              width=\"600\"\n              height=\"450\"\n              loading=\"lazy\"\n            >\n\t\t\t</a>\n          </div>\n          <div class=\"rs-din-content\">\n            <h3>Europa</h3>\n            <p>\n              Period-inspired styling suited to European vehicles from the\n              1960s and 1970s.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rs-din-item\">\n          <div class=\"rs-din-image\">\n\t\t\t<a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/retrosound-grand-prix-radio\"\n            aria-label=\"Learn about Din Solutions Grand Prix Radio\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/600x450-grand-prix-hero.jpg?v=1785959439\"\n              alt=\"RetroSound Grand Prix DIN radio\"\n              width=\"600\"\n              height=\"450\"\n              loading=\"lazy\"\n            >\n\t\t\t</a>\n          </div>\n          <div class=\"rs-din-content\">\n            <h3>Grand Prix</h3>\n            <p>\n              A paddle-control design developed for European interiors from the\n              1980s.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rs-din-item\">\n          <div class=\"rs-din-image\">\n\t\t\t <a\n            class=\"rs-category-image-link\"\n            href=\"https://www.retromanufacturing.com/collections/retrosound-monza-radio\"\n            aria-label=\"Learn about Din Solutions Monza Radio\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/600x450-monza-her.jpg?v=1785959438\"\n              alt=\"RetroSound Monza DIN radio\"\n              width=\"600\"\n              height=\"450\"\n              loading=\"lazy\"\n            >\n\t\t\t</a>\n          </div>\n          <div class=\"rs-din-content\">\n            <h3>Monza</h3>\n            <p>\n              A clean, all-black design