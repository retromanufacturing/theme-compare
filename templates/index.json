        "liquid_BYmE3k": {
          "type": "liquid",
          "settings": {
            "code": "<style>\n\n.rs-featured{\n    max-width:1440px;\n    margin:0 auto;\n    padding:70px 20px;\n}\n.rs-featured-header{\n    text-align:center;\n    max-width:760px;\n    margin:0 auto 40px;\n}\n.rs-featured-eyebrow{\n    color:#A41B1A;\n    text-transform:uppercase;\n    font-size:13px;\n    font-weight:700;\n    letter-spacing:.12em;\n    margin-bottom:8px;\n}\n.rs-featured-title{\n    font-size:46px;\n    font-weight:800;\n    line-height:1.05;\n    margin-bottom:12px;\n}\n.rs-featured-intro{\n    font-size:17px;\n    color:#4a4a4a;\n    line-height:1.6;\n}\n.rs-feature-grid{\n    display:grid;\n    grid-template-columns:2fr 1fr;\n    gap:22px;\n}\n.rs-feature-hero{\n    border:1px solid #ddd;\n    border-radius:5px;\n    overflow:hidden;\n    background:#fff;\n    display:flex;\n    flex-direction:column;\n}\n.rs-feature-image{\n    background:#f4f4f4;\n    aspect-ratio:16/10;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    color:#777;\n    font-size:14px;\n}\n.rs-feature-content{\n    padding:30px;\n}\n.rs-product-tag{\n    display:inline-block;\n    background:#A41B1A;\n    color:#fff;\n    font-size:12px;\n    font-weight:700;\n    padding:6px 12px;\n    border-radius:40px;\n    margin-bottom:18px;\n}\n.rs-feature-content h3{\n    font-size:34px;\n    margin-bottom:14px;\n    margin-top:10px;\n}\n.rs-feature-content p{\n    font-size:17px;\n    line-height:1.6;\n    color:#444;\n    margin-bottom:24px;\n}\n.rs-btn{\n    display:inline-block;\n    padding:12px 22px;\n    background:#A41B1A;\n    color:#fff;\n    text-decoration:none;\n    border-radius:4px;\n    font-weight:700;\n}\n.rs-side{\n    display:flex;\n    flex-direction:column;\n    gap:22px;\n}\n.rs-small-card{\n    border:1px solid #ddd;\n    border-radius:5px;\n    overflow:hidden;\n    background:#fff;\n}\n.rs-small-image{\n    aspect-ratio:16/9;\n    background:#f4f4f4;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    color:#777;\n}\n.rs-small-content{\n    padding:22px;\n}\n.rs-small-content h4{\n    font-size:24px;\n    margin-bottom:10px;\n}\n.rs-small-content p{\n    font-size:15px;\n    color:#555;\n    line-height:1.55;\n    margin-bottom:14px;\n}\n.rs-link{\n    color:#A41B1A;\n    font-weight:700;\n    text-decoration:none;\n}\n@media(max-width:980px){\n.rs-feature-grid{\n    grid-template-columns:1fr;\n}\n}\n</style>\n\n<section class=\"rs-featured\">\n\t<div class=\"rs-featured-header\">\n\t\t<div class=\"rs-featured-eyebrow\">Featured Products</div>\n\t\t<h2 class=\"rs-featured-title\">Discover What's New</h2>\n\t\t\t<p class=\"rs-featured-intro\">Explore the latest additions to the RetroSound lineup, from new radio designs to the newest technology for your classic vehicle.</p>\n\t</div>\n\t<div class=\"rs-feature-grid\">\n\t\t<div class=\"rs-feature-hero\">\n\t\t\t<div class=\"rs-feature-image\">\n\t\t\t\t<img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/1600x1000-new-product-hero-traffic-or.jpg?v=1784140107\" alt=\"classic style dashboard installation icon\">\n\t\t\t</div>\n\t\t\t<div class=\"rs-feature-content\">\n\t\t\t<div class=\"rs-product-tag\">NEW FOR 2026</div>\n\t\t\t\t<h3>Traffic Radio</h3>\n\t\t\t\t<p>Inspired by late-model European factory radios, the Traffic combines understated OEM styling with Bluetooth, HD Radio, SiriusXM capability, app control and more.</p>\n\t\t\t\t<a href=\"https://www.retromanufacturing.com/collections/retrosound-traffic-radio\" class=\"rs-btn\">Learn More</a>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"rs-side\">\n\t\t\t<div class=\"rs-small-card\">\n\t\t\t\t<div class=\"rs-small-image\">\n\t\t\t\t\t<img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/800x450-new-product-hero-monza.jpg?v=1784140107\" alt=\"classic style dashboard installation icon\">\n\t\t\t\t</div>\n\t\t\t\t<div class=\"rs-small-content\">\n\t\t\t\t\t<h4>Monza</h4>\n\t\t\t\t\t<p>Designed for classic BMW, Mercedes-Benz, Jaguar and MGB interiors.</p>\n\t\t\t\t\t<a href=\"https://www.retromanufacturing.com/collections/retrosound-monza-radio\" class=\"rs-link\">Learn More →</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"rs-small-card\">\n\t\t\t\t<div class=\"rs-small-image\">\n\t\t\t\t\t<img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/800x450-new-product-hero-m4hd1.jpg?v=1784140107\" alt=\"classic style dashboard installation icon\">\n\t\t\t\t</div>\n\t\t\t\t<div class=\"rs-small-content\">\n\t\t\t\t\t<h4>Motor 4HD</h4>\n\t\t\t\t\t<p>Our most advanced radio motor featuring HD Radio, SiriusXM capability and app compatibility.</p>\n\t\t\t\t\t<a href=\"https://www.retromanufacturing.com/pages/retrosound-radio-motors\" class=\"rs-link\">Learn More →</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
            "width": "100%",
