        "liquid_z3MBAL": {
          "type": "liquid",
          "settings": {
            "code": "<style>\n  .rs-why-section {\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 56px 20px;\n    background: #ffffff;\n    color: #1f1f1f;\n  }\n\n  .rs-why-header {\n    text-align: center;\n    max-width: 820px;\n    margin: 0 auto 36px;\n  }\n\n  .rs-why-eyebrow {\n    font-size: 13px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    font-weight: 700;\n    color: #a41b1a;\n    margin-bottom: 10px;\n  }\n\n  .rs-why-title {\n    font-size: clamp(30px, 4vw, 46px);\n    line-height: 1.05;\n    margin: 0 0 14px;\n    font-weight: 800;\n  }\n\n  .rs-why-intro {\n    font-size: 17px;\n    line-height: 1.55;\n    margin: 0;\n    color: #4a4a4a;\n  }\n\n  .rs-why-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .rs-why-card {\n    border: 1px solid #d9d9d9;\n    border-radius: 5px;\n    background: #fff;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    min-height: 100%;\n  }\n\n  .rs-why-image {\n    background: #f5f5f5;\n    aspect-ratio: 4 / 3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-bottom: 1px solid #e3e3e3;\n  }\n\n  .rs-why-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .rs-placeholder {\n    color: #777;\n    font-size: 13px;\n    text-align: center;\n    padding: 20px;\n  }\n\n  .rs-why-content {\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n  }\n\n  .rs-card-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 14px;\n  }\n\n  .rs-card-icon {\n    width: 46px;\n    height: 46px;\n    border-radius: 50%;\n    background: #a41b1a;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    flex: 0 0 46px;\n  }\n\t.rs-card-icon img {\n\t\tmax-width: 46px;\n\t}\n\t\n  .rs-why-card h3 {\n    font-size: 18px;\n    line-height: 1.12;\n    margin: 0;\n    font-weight: 800;\n  }\n\n  .rs-why-card p {\n    font-size: 15.5px;\n    line-height: 1.55;\n    color: #333;\n    margin: 0;\n  }\n\n  .rs-card-note {\n    margin-top: auto;\n    text-align:center;\n    color: #a41b1a;\n  }\n  .rs-card-note img {\n\tmax-width: 100%;\n\t  align-content: center\n\t}\n  .rs-feature-icons {\n    display: flex;\n    justify-content: center;\n    margin-top: 22px;\n    padding-top: 18px;\n    border-top: 1px solid #e5e5e5;\n  }\n\n  .rs-feature-icons span {\n    width: 56px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 6px;\n  }\n\t.rs-feature-icons img {\n\t\tmax-width: 100%;\n\t}\n  @media screen and (max-width: 1100px) {\n    .rs-why-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 640px) {\n    .rs-why-section {\n      padding: 40px 16px;\n    }\n\n    .rs-why-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .rs-why-content {\n      padding: 22px;\n    }\n\n    .rs-card-heading {\n      align-items: flex-start;\n    }\n\n    .rs-why-card h3 {\n      font-size: 22px;\n    }\n  }\n</style>\n\n<section class=\"rs-why-section\">\n  <div class=\"rs-why-header\">\n    <div class=\"rs-why-eyebrow\">Why RetroSound?</div>\n    <h2 class=\"rs-why-title\">Designed for Classic Vehicles</h2>\n    <p class=\"rs-why-intro\">\n      RetroSound radios are built to preserve the look of your classic dashboard while adding the modern audio features today’s drivers expect.\n    </p>\n  </div>\n\n  <div class=\"rs-why-grid\">\n\n<article class=\"rs-why-card\">\n  <div class=\"rs-why-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/rm-image-classic-look-dash-card_2fe041ab-f97d-4cac-80bf-b0d2c7b43bfe.jpg?v=1784130241\" alt=\"classic style dashboard installation icon\">\n  </div>\n  <div class=\"rs-why-content\">\n    <div class=\"rs-card-heading\">\n      <div class=\"rs-card-icon\"> <img \n    src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/red-icon-rm-classic-style.png?v=1782753907\"\n    alt=\"classic style icon\"\n  ></div>\n      <h3>Classic Style. Modern Sound.</h3>\n    </div>\n    <p>\n\n      Keep the timeless look of your classic dashboard while enjoying modern features like Bluetooth, USB, HD Radio, SiriusXM capability, and customizable display colors.\n    </p>\n    <div class=\"rs-feature-icons\">\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-bluetooth.png?v=1782766080\" alt=\"classic style icon\"></span>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-usb.png?v=1782766080\" alt=\"classic style icon\"></span>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-hd-radio.png?v=1782766080\" alt=\"classic style icon\"></span>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-sirius-xm.png?v=1782766080\" alt=\"classic style icon\"></span>\n    </div>\n  </div>\n</article>\n\n<article class=\"rs-why-card\">\n  <div class=\"rs-why-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/rm-image-built-for-classics-card.jpg?v=1782767470\" alt=\"classic car group icon\">\n  </div>\n  <div class=\"rs-why-content\">\n    <div class=\"rs-card-heading\">\n      <div class=\"rs-card-icon\"><img \n    src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/red-icon-rm-designed-for-classics.png?v=1782753907\"\n    alt=\"classic style icon\"\n  ></div>\n      <h3>Designed for Your Classic.</h3>\n    </div>\n    <p>\n      With over 1,000 vehicle applications, RetroSound offers solutions for classic cars and trucks from the 1940s through the 1990s.\n    </p>\n    <div class=\"rs-card-note\"><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/Text-over-1000-apps.png?v=1782755240\" alt=\"over 1000 applications text icon\"></div>\n  </div>\n</article>\n\n<article class=\"rs-why-card\">\n  <div class=\"rs-why-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/rm-image-radio-custom-build.jpg?v=1784130266\" alt=\"customizeable radio build  icon\">\n  </div>\n  <div class=\"rs-why-content\">\n    <div class=\"rs-card-heading\">\n      <div class=\"rs-card-icon\"><img \n    src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/red-icon-rm-build-radio.png?v=1782753907\"\n    alt=\"build your radio icon\"\n  ></div>\n      <h3>Build the Radio That’s Right for You.</h3>\n    </div>\n    <p>\n      Choose the appearance and features that fit your build. Select from multiple radio styles, display options, and feature packages including Bluetooth, HD Radio, SiriusXM readiness, DAB+, and app compatibility.\n    </p>\n  </div>\n</article>\n\n<article class=\"rs-why-card\">\n  <div class=\"rs-why-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/rm-image-installation-parts.jpg?v=1784130254\" alt=\"radio installation parts icon\">\n  </div>\n  <div class=\"rs-why-content\">\n    <div class=\"rs-card-heading\">\n      <div class=\"rs-card-icon\"><img \n    src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/red-icon-rm-getting-started.png?v=1782753907\"\n    alt=\"getting started icon\"\n  ></div>\n      <h3>Everything You Need to Get Started.</h3>\n    </div>\n    <p>\n      Whether you’re a first-time installer or an experienced builder, RetroSound provides vehicle-specific accessories, detailed guides, wiring information, and knowledgeable support.\n    </p>\n    <div class=\"rs-feature-icons\">\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-detailed-guides.png?v=1782762741\" alt=\"detailed guides icon\"></span>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-expert-support.png?v=1782762718\" alt=\"expert support icon\"></span>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0932/8664/files/feature-icon-dependability.png?v=1782762730\" alt=\"built for dependability icon\"></span>\n    </div>\n  </div>\n</article>\n\n  </div>\n</section>",
            "width": "100%",
