{%- liquid
  assign filters = section.settings.vehicle_search_filters
  assign current_tags_joined = current_tags | join: '+' | downcase
-%}

{%- if filters != blank -%}
  {%- capture cards -%}
    {%- for entry in filters -%}
      {%- liquid
        assign entry_name = entry.name.value | downcase
        if entry.is_universal.value == true
          assign filter_url = '/collections/vehicle-search/universal-products+' | append: entry_name
        else
          assign filter_url = '/collections/vehicle-search/' | append: current_tags_joined | append: '+' | append: entry_name
        endif
      -%}
      {%- render 'list.collection-card',
        collection_title: entry.name.value,
        collection_grid_image: entry.image.value,
        collection_link: filter_url,
        collection_grid_shape: 'square',
        collection_grid_color: 'grey',
        sizeVariable: 'medium-up--one-sixth',
        fallback: '30vw'
      -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- render 'layout.section', slot: content -%}
  {%- render 'layout.grid',
    slot: cards,
    columns_xs: 3,
    columns_md: section.settings.vehicle_search_filters.size,
    gap_xs: 'sm',
    gap_md: 'md'
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Vehicle Search Logos",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "vehicle_search_filters",
      "label": "Vehicle search filters",
      "metaobject_type": "vearch_search_filter"
    }
  ],
  "presets": [{ "name": "Vehicle Search Logos" }]
}
{% endschema %}