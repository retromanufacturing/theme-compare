{%- render 'section.product-recommendations-fitment' -%}

{% schema %}
{
  "name": "Fitment recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows other products in the vehicle-search collection matching the same fitment. Only renders when this product page was reached through a vehicle-search filtered link; add the metafield-based fallback section for other entry points."
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "t:labels.heading",
      "default": "Also fits your vehicle"
    },
    {
      "type": "range",
      "id": "related_count",
      "label": "t:labels.number_of_related",
      "default": 6,
      "min": 2,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "t:labels.desktop_products_per",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}