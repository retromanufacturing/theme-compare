{%- liquid
  assign build_list = section.settings.bundle_products
  assign count = 1
-%}

{% capture blocks %}
  <div>
    {% content_for 'blocks' %}
  </div>
{% endcapture %}

{% render 'section-main-product', slot: blocks %}

{% for build in build_list %}
  {%- liquid
    assign is_build = true
    assign product_count = forloop.index | plus: count
    assign build_products = build.products.value
    assign last_build = false
    if forloop.last
      assign last_build = true
    endif
  -%}
  <bundle-builder>
    {% for product in build_products %}
      {%- liquid
        assign first_product = false
        if forloop.first
          assign first_product = true
        endif
      -%}

      {% content_for 'block',
        type: 'bundle-content',
        id: 'bundle-builder',
        is_build: is_build,
        product: product,
        build: build
      %}
    {% endfor %}
  </bundle-builder>
{% endfor %}

{% schema %}
{
  "name": "Bundle Builder Products",
  "settings": [
     {
        "type": "metaobject_list",
        "id": "bundle_products",
        "label": "Bundle products",
        "metaobject_type": "build_your_own"
      },
    {
    "type": "header",
    "content": "t:labels.media"
  },
  {
    "type": "paragraph",
    "content": "t:info.learn_more_media_types"
  },
  {
    "type": "select",
    "id": "image_position",
    "label": "t:labels.position",
    "default": "left",
    "options": [
      {
        "value": "left",
        "label": "t:labels.alignments.left"
      },
      {
        "value": "right",
        "label": "t:labels.alignments.right"
      }
    ]
  },
  {
    "type": "select",
    "id": "image_container_size",
    "label": "t:labels.size",
    "default": "medium",
    "options": [
      {
        "value": "small",
        "label": "t:labels.sizes.small"
      },
      {
        "value": "medium",
        "label": "t:labels.sizes.medium"
      },
      {
        "value": "large",
        "label": "t:labels.sizes.large"
      }
    ]
  },
  {
    "type": "select",
    "id": "product_image_size",
    "label": "t:actions.force_image_size",
    "default": "square",
    "options": [
      {
        "value": "natural",
        "label": "t:labels.natural"
      },
      {
        "value": "square",
        "label": "t:labels.square_11"
      },
      {
        "value": "landscape",
        "label": "t:labels.landscape_43"
      },
      {
        "value": "portrait",
        "label": "t:labels.portrait_23"
      }
    ]
  },
  {
    "type": "checkbox",
    "id": "product_zoom_enable",
    "label": "t:actions.enable_image_zoom",
    "default": true
  },
  {
    "type": "select",
    "id": "thumbnail_position",
    "label": "t:labels.thumbnail_position",
    "default": "beside",
    "options": [
      {
        "value": "beside",
        "label": "t:labels.next_to_media"
      },
      {
        "value": "below",
        "label": "t:labels.below_media"
      }
    ]
  },
  {
    "type": "select",
    "id": "thumbnail_height",
    "label": "t:labels.thumbnail_height",
    "info": "t:info.applys_when_thumbnail_next_to_media",
    "default": "flexible",
    "options": [
      {
        "value": "fixed",
        "label": "t:labels.fixed"
      },
      {
        "value": "flexible",
        "label": "t:labels.flexible"
      }
    ]
  },
  {
    "type": "checkbox",
    "id": "thumbnail_arrows",
    "label": "t:actions.show_thumbnail_arrows"
  },
  {
    "type": "select",
    "id": "mobile_layout",
    "label": "t:labels.mobile_layout",
    "default": "partial",
    "options": [
      {
        "value": "partial",
        "label": "t:labels.75_width"
      },
      {
        "value": "full",
        "label": "t:labels.full_width"
      }
    ]
  },
  {
    "type": "checkbox",
    "id": "enable_video_looping",
    "label": "t:actions.enable_video_looping",
    "default": true
  },
  {
    "type": "select",
    "id": "product_video_style",
    "label": "t:labels.video_style",
    "default": "muted",
    "options": [
      {
        "value": "muted",
        "label": "t:labels.video_without_sound"
      },
      {
        "value": "unmuted",
        "label": "t:labels.video_with_sound"
      }
    ],
    "info": "t:info.video_with_sound_not_autoplay"
  }
  ],
  "blocks": [{ "type": "@theme"}, {"type": "@app"}],
}
{% endschema %}
