{%- liquid
  assign isModal = false
  if template == 'product.modal'
    assign isModal = true
  endif

  assign isAjax = false
  if template == 'product.ajax'
    assign isAjax = true
  endif

  assign build_list = product.metafields.build.build_your_own_products.value
  assign count = 1 
-%} 
  <div class="js-build-default js-active-product"
    data-option-name="{{ product.metafields.build.build_your_own_title }}"
    data-product-id="{{ product.id }}"
    data-product-position="default">
    {%- render 'product-template-build',
      product: product,
      section_id: section.id,
      blocks: section.blocks,
      image_position: section.settings.image_position,
      image_container_width: section.settings.image_container_size,
      image_size: section.settings.product_image_size,
      product_zoom_enable: section.settings.product_zoom_enable,
      sku_enable: section.settings.sku_enable,
      price_position: section.settings.price_position,
      title_position: section.settings.title_position,
      isModal: isModal,
      isAjax: isAjax,
      thumbnail_position: section.settings.thumbnail_position,
      thumbnail_arrows: section.settings.thumbnail_arrows,
      mobile_layout: section.settings.mobile_layout,
      video_looping: section.settings.enable_video_looping,
      video_style: section.settings.product_video_style,
      product_count: count,
      product_title: product.title,
      build_name: product.metafields.build.build_your_own_title,      
      build_required: true,
      first_product: true,
    -%}
  </div>
{% for build in build_list %}
  {%- liquid       
     assign product_count =  forloop.index | plus: count
     assign build_products = build.products.value
     assign last_build = false
     if forloop.last
         assign last_build =  true  
     endif
  -%}


  {% for product in build_products %}  
    {%- liquid    
       assign first_product = false      
       if forloop.first
         assign first_product =  true  
       endif       
    -%}
    <div class="js-build-product-layout{% if first_product %} js-active-product{% endif %}"
      data-option-name="{{ build.name }}"
      data-product-id="{{ product.id }}"
      data-product-name="{{ product.title }}"
      data-product-position="{% if first_product %}default{% endif %}"
      data-default-variant="{% if forloop.first %}{{ product.id }}{% endif %}">
      {%- render 'product-template-build',
        product: product,
        section_id: section.id,
        blocks: section.blocks,
        image_position: section.settings.image_position,
        image_container_width: section.settings.image_container_size,
        image_size: section.settings.product_image_size,
        product_zoom_enable: section.settings.product_zoom_enable,
        sku_enable: section.settings.sku_enable,
        price_position: section.settings.price_position,
        title_position: section.settings.title_position,
        isModal: isModal,
        isAjax: isAjax,
        thumbnail_position: section.settings.thumbnail_position,
        thumbnail_arrows: section.settings.thumbnail_arrows,
        mobile_layout: section.settings.mobile_layout,
        video_looping: section.settings.enable_video_looping,
        video_style: section.settings.product_video_style,
        product_count: product_count, 
        build_products: build_products,
        build_name: build.name,
        build_remove_name: build.remove_name, 
        build_required: build.required, 
        build_disclaimer: build.disclaimer, 
        first_product: first_product,
        last_build: last_build,
        build: build,
      -%}  
    </div>
  {% endfor %}
{% endfor %}

<div class="grid">
  <div class="grid__item-custom medium-up--one-half"></div>
  <div class="grid__item-custom medium-up--one-half btn--build">
    <button class="js-build-add-to-cart btn btn--full">{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</div>

{{ 'build-your-own.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'build-your-own.js' | asset_url }}" defer="defer"></script>

