{% doc %}
  Dimensions calculator — lets a shopper enter their dash opening's width and
  height (mm or inches) plus shaft spacing, and filters a pre-rendered list of
  every variant in the target collection down to the ones that fit, within a
  configurable tolerance. No match falls back to a contact form.

  @param {string} [title] - Page heading
  @param {object} [collection] - Collection to search
  @param {array} [product_page_list] - Products that link straight to their product page instead of the Build Your Own builder
  @param {array} [combine_list] - Products whose variants should collapse into a single result card
  @param {number} [tolerance_percent] - Match tolerance, as a whole percent (e.g. 5). Default: 5

  @example
  {% render 'custom.section.dimensions', title: 'Enter Your Dimensions', collection: collection, tolerance_percent: 5 %}
{% enddoc %}

{%- liquid
  assign tolerance_percent = tolerance_percent | default: 5
  assign build_url = '/products/retroradio-build-your-own-radio?build'

  capture name_label
    render 'utility.translate', key: 'labels.name', fallback: 'Name'
  endcapture

  capture email_label
    render 'utility.translate', key: 'labels.email', fallback: 'Email'
  endcapture

  capture message_label
    render 'utility.translate', key: 'labels.message', fallback: 'Message'
  endcapture

  capture send_label
    render 'utility.translate', key: 'actions.send', fallback: 'Send'
  endcapture

  capture mm_toggle_label
    render 'element.button', text: 'Millimeters', inverted: true
  endcapture

  capture inches_toggle_label
    render 'element.button', text: 'Inches', inverted: true
  endcapture

  capture recalculate_button
    render 'element.button', text: 'Enter New Dimensions', attributes: 'data-dimensions-recalculate'
  endcapture
-%}

<dimensions-finder data-tolerance-percent="{{ tolerance_percent }}">
  <div class="page-width page-content">
    <header class="section-header">
      <h1 class="section-header__title">{{ title }}</h1>
    </header>

    <div class="dimensions__instructions rte" data-dimensions-instructions>
      {{ page.content }}
    </div>

    <div class="note hide" data-dimensions-no-results>
      <p><strong>Your search brought up no results.</strong></p>
      <p>Don't despair. You can complete the form below and our expert team will try to find a fitment, or {{ recalculate_button }}</p>
    </div>

    <div class="dimensions__results hide" data-dimensions-results>
      <div class="dimensions__results-grid">
        {%- for product in collection.products -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign skip_variant = false
              if combine_list contains product and forloop.index != 1
                assign skip_variant = true
              endif
            -%}

            {%- unless skip_variant -%}
              {%- liquid
                assign dimensions = variant.metafields.dimensions.width_height.value
                assign width_mm = dimensions.first | remove: ' mm'
                assign height_mm = dimensions.last | remove: ' mm'
                assign width_inches = width_mm | divided_by: 25.4
                assign height_inches = height_mm | divided_by: 25.4
                assign variant_sku = variant.sku | remove: '-'

                if product_page_list contains product
                  assign result_url = product.url
                  assign result_button_text = 'View Radio'
                else
                  assign result_url = build_url | append: '=' | append: product.id | append: '+' | append: variant_sku | append: '&dimensions=' | append: product.title | append: '+' | append: variant_sku
                  assign result_button_text = 'Build Radio'
                endif

                assign result_image = variant.image | default: product.featured_image
              -%}

              <div
                class="dimensions__results-product{% unless dimensions %} hide{% endunless %}"
                data-width="{{ width_mm }}"
                data-height="{{ height_mm }}"
              >
                {%- render 'element.image', img: result_image, alt: product.title, widths: '160, 280, 360, 540', sizeVariable: '160px' -%}
                <div class="dimensions__results-data">
                  <p class="dimensions__results-title">{{ product.title }}</p>
                  <p><span>Part Number:</span> {{ variant.sku }}</p>
                  <p><span>Width:</span> {{ width_mm }} mm / {{ width_inches | round: 2 }} in</p>
                  <p><span>Height:</span> {{ height_mm }} mm / {{ height_inches | round: 2 }} in</p>
                </div>
                {%- render 'element.button', text: result_button_text, href: result_url, full: true, attributes: 'target="_blank"' -%}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="dimensions__form" data-dimensions-form>
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {%- render 'utility.translate', key: 'info.contact_confirmation', fallback: "Thanks for contacting us. We'll get back to you as soon as possible." -%}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <input type="hidden" name="contact[Type of Question]" value="Send Us Your Dimensions-Webform">

        <fieldset class="dimensions__units">
          <legend class="visually-hidden">Units</legend>
          {%- render 'element.radio', name: 'dimensions-units', value: 'mm', checked: true, display_icon: false, slot: mm_toggle_label, attributes: 'data-dimensions-unit' -%}
          {%- render 'element.radio', name: 'dimensions-units', value: 'inches', display_icon: false, slot: inches_toggle_label, attributes: 'data-dimensions-unit' -%}
        </fieldset>

        <div class="float-grid grid--small clearfix hide" data-dimensions-hidden-fields>
          <span class="grid__item medium-up--one-half">
            <label for="ContactFormName">{{ name_label }}</label>
            <input type="text" id="ContactFormName" name="contact[name]" placeholder="{{ name_label }}" autocapitalize="words" data-dimensions-hidden-input value="{{ customer.name }}">
          </span>
          <span class="grid__item medium-up--one-half">
            <label for="ContactFormEmail">{{ email_label }}</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="{{ email_label }}" autocorrect="off" autocapitalize="off" data-dimensions-hidden-input value="{{ customer.email }}">
          </span>
        </div>

        <div class="float-grid grid--small clearfix">
          <span class="grid__item medium-up--one-third">
            <label for="WidthOpening">Width of Opening</label>
            <input type="number" step=".01" name="contact[Width]" id="WidthOpening" placeholder="Use decimals for inches or millimeters" required data-dimensions-width>
          </span>
          <span class="grid__item medium-up--one-third">
            <label for="HeightOpening">Height of Opening</label>
            <input type="number" step=".01" name="contact[Height]" id="HeightOpening" placeholder="Use decimals for inches or millimeters" required data-dimensions-height>
          </span>
          <span class="grid__item medium-up--one-third">
            <label for="ShaftSpacing">Shaft Spacing</label>
            <input type="number" step=".01" name="contact[Shaft Spacing]" id="ShaftSpacing" placeholder="Use decimals for inches or millimeters" required>
          </span>
        </div>

        <div class="float-grid grid--small clearfix hide" data-dimensions-hidden-fields>
          <span class="grid__item medium-up--one-third">
            <label for="Year">Year</label>
            <input type="number" name="contact[Year]" id="Year" placeholder="Year" data-dimensions-hidden-input>
          </span>
          <span class="grid__item medium-up--one-third">
            <label for="Make">Make</label>
            <input type="text" name="contact[Make]" id="Make" placeholder="Make" data-dimensions-hidden-input>
          </span>
          <span class="grid__item medium-up--one-third">
            <label for="Model">Model</label>
            <input type="text" name="contact[Model]" id="Model" placeholder="Model" data-dimensions-hidden-input>
          </span>

          <label for="ContactFormMessage">{{ message_label }}</label>
          <textarea rows="5" id="ContactFormMessage" name="contact[body]" placeholder="{{ message_label }}" data-dimensions-hidden-input></textarea>

          {%- render 'element.button', text: send_label, type: 'submit' -%}
        </div>

        {%- render 'element.button', text: 'Calculate Dimensions', type: 'button', disabled: true, attributes: 'data-dimensions-calculate' -%}
      {%- endform -%}
    </div>
  </div>
</dimensions-finder>

<script type="module">
  import 'custom.dimensions-finder'
</script>

{% stylesheet %}
  .dimensions__results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--gutter);
  }

  .dimensions__results-product {
    border: 1px solid color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));
    border-radius: 4px;
    padding: 12px;
  }

  .dimensions__results-title {
    font-weight: 700;
    margin-bottom: 8px;
  }

  [data-dimensions-form] input,
  [data-dimensions-form] textarea {
    border: 1px solid color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));
    padding: 8px 10px;
    border-radius: 0;
    width: 100%;
    max-width: 100%;
  }

  [data-dimensions-form] label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  [data-dimensions-form] .grid__item {
    margin-bottom: 1.25em;
  }

  .dimensions__units {
    display: flex;
    gap: 8px;
    align-items: center;
    border: 0;
    padding: 0;
    margin-bottom: 24px;
  }

  .note {
    padding: 20px;
    margin-bottom: 24px;
  }

  .note :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}