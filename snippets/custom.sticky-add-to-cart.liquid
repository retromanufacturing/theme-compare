{% doc %}
  A floating add-to-cart bar that appears once the real buy buttons scroll
  out of view, and hides again near the footer. Clicking its button submits
  the real product form (see product-form-{{ section.id }}) rather than
  duplicating the add-to-cart logic - block.product-buy-buttons.js handles
  the actual cart request either way.
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign image_to_show = current_variant.featured_image | default: product.featured_image

  assign has_single_option = false
  if product.has_only_default_variant != true and product.options.size == 1
    assign has_single_option = true
  endif

  assign has_image = false
  if image_to_show != blank
    assign has_image = true
  endif
-%}

<sticky-add-to-cart
  class="sticky-add-to-cart"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-width="{{ block.settings.sticky_width }}"
  data-position-selector="{{ block.settings.position_selector }}"
  data-position-placement="{{ block.settings.position_placement }}"
  data-variant-available="{{ current_variant.available }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-anchor="bottom"
  data-stuck="false"
  role="region"
  aria-label="{{ 'custom.product.sticky_add_to_cart' | t }}"
>
  {%- if has_image -%}
    <div class="sticky-add-to-cart__image">
      {{
        image_to_show
        | image_url: width: 120
        | image_tag: loading: 'lazy', alt: image_to_show.alt
        | default: product.title, class: 'sticky-add-to-cart__image-img', srcset: null, sizes: null
      }}
    </div>
  {%- endif -%}

  <div
    class="sticky-add-to-cart__info"
    data-has-image="{{ has_image }}"
    data-singleton="{{ product.has_only_default_variant }}"
    data-single-option="{{ has_single_option }}"
  >
    <p class="sticky-add-to-cart__title">{{ product.title | escape }}</p>
    {%- unless product.has_only_default_variant -%}
      <div class="sticky-add-to-cart__variant">{{ current_variant.title | escape }}</div>
    {%- endunless -%}
  </div>

  <div class="sticky-add-to-cart__price">
    {%- render 'block.product-price', product: product, use_variant: true -%}
  </div>

  {%- liquid
    if current_variant.available
      assign button_text = 'actions.add_to_cart' | t
    elsif current_variant == blank
      assign button_text = 'info.unavailable' | t
    else
      assign button_text = 'info.sold_out' | t
    endif

    assign is_unavailable = false
    unless current_variant.available
      assign is_unavailable = true
    endunless
  -%}
  {%- render 'element.button',
    text: button_text,
    type: 'button',
    classlist: 'sticky-add-to-cart__button',
    disabled: is_unavailable,
    full: true,
    attributes: 'data-sticky-add-to-cart-button'
  -%}
</sticky-add-to-cart>

<script type="module">
  import 'custom.sticky-add-to-cart';
</script>

{% stylesheet %}
  sticky-add-to-cart {
    display: flex;
    align-items: center;
    gap: 16px;
    position: fixed;
    left: 0;
    right: 0;
    bottom: var(--sticky-offset, 0px);
    z-index: var(--z-index-toolbar);
    opacity: 0;
    transform: translateY(var(--sticky-hide-y, 100%));
    padding: 16px calc(var(--gutter, 20px));
    background: var(--color-secondary);
    color: var(--color-primary);
    box-shadow: var(--drawer-box-shadow);
    transition: var(--slide-curve);
  }

  sticky-add-to-cart[data-anchor='top'] {
    bottom: auto;
    top: var(--sticky-offset, 0px);
  }

  sticky-add-to-cart[data-width='constrained'] {
    width: 600px;
    max-width: calc(100% - 32px);
    margin: 0 auto;
    border-radius: var(--element-button-radius);
  }

  sticky-add-to-cart[data-stuck='true'] {
    opacity: 1;
    transform: translateY(0%);
  }

  sticky-add-to-cart:not([data-variant-available='true']) {
    opacity: 0;
    display: none;
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    width: 50px;
    overflow: hidden;
    border-radius: var(--element-button-radius);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0;
  }
{% endstylesheet %}