{%- liquid
  assign motor_accessories = current_variant.metafields.custom.radio_features.value.accessories.value
-%}

{%- capture all_restricted_ids -%}
  {%- for entry in shop.metaobjects.product_data.values -%}
    {%- for accessory in entry.accessories.value -%}
      {{ accessory.id }},
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign all_restricted_ids = all_restricted_ids | split: ',' | uniq -%}

{%- capture accessory_ids_by_variant -%}
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": [
        {%- for accessory in variant.metafields.custom.radio_features.value.accessories.value -%}
          {{ accessory.id }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

{{ 'https://accessories.w3apps.co/js/accessories.js' | script_tag }}

<script type="text/javascript">
  if (Shopify.designMode != true) {
    accessoriesJS($);
  }
</script>
<script type="text/javascript">
  var allRestrictedIds = [{{ all_restricted_ids | join: ',' }}];
  var accessoryIdsByVariant = {{ accessory_ids_by_variant }};
  var motorAccessoryIds = accessoryIdsByVariant[{{ current_variant.id }}] || [];

  function accessoryItemAddedCallback(div, product) {
    var isRestricted = allRestrictedIds.indexOf(product.id) !== -1;
    var isForCurrentMotor = motorAccessoryIds.indexOf(product.id) !== -1;

    if (isRestricted && !isForCurrentMotor) {
      div.addClass("hide");
    }
  }
</script>

<script type="module">
  import { EVENTS } from '{{ 'util.events.js' | asset_url }}';

  document.addEventListener(`${EVENTS.variantChange}:{{ section.id }}:{{ product.id }}`, (event) => {
    if (!event.detail.variant || event.detail.loading) return;

    motorAccessoryIds = accessoryIdsByVariant[event.detail.variant.id] || [];

    $('.accessories-item').each(function () {
      var productId = Number($(this).find('.accessory-variant-select').attr('name'));
      var isRestricted = allRestrictedIds.indexOf(productId) !== -1;
      var isForCurrentMotor = motorAccessoryIds.indexOf(productId) !== -1;

      $(this).toggleClass('hide', isRestricted && !isForCurrentMotor);
    });
  });
</script>

{% style %}
  /* Product Accessories */
#accessories-modal-right .accessory-description .product__desc-features, #accessories-modal-right .accessory-description .product__desc-specs{ 
  display: none;
}     
    
#accessories-container-heading h3 {
  font-size: 1.2em !important;
  line-height: .9em !important;
  margin-bottom: 0px !important;
  font-weight: bold;
  text-align: center;
  font-family:var(--typeBasePrimary),var(--typeBaseFallback);
}
    
#accessories-info-text {
  border-top: 2px solid var(--colorBtnPrimary);
  text-align: center;
}    

.accessories-title, .accessories-item select, .accessories-item option {
   font-size: 14px !important;
}

.accessories-item  {  
  margin-bottom: 10px !important;
} 

.accessories-item img {  
  max-width: 120px !important;
} 

.accessories-item input {  
  margin-top: 1px !important;
}     
    
.accessories-item input[type=checkbox] {
   width: 20px !important;
   height: 20px !important;
}  

.accessory-price {
   color: var(--colorBtnPrimary);
   font-weight: bold;
   font-size: 14px !important;
} 

@media screen and (min-width: 769px){
  .collapsible-content__inner  #w3-product-accessories {
    margin-top: 0rem !important;
  }
  
  #w3-product-accessories{
    margin-top: 0.5rem !important;
    margin-bottom: 1.5rem !important;
  }
}  

@media screen and (max-width: 768px){
  #w3-product-accessories{
    margin-top: 30px! important;
  }
}   
{% endstyle %}