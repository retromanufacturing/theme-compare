{% comment %}
  Shows extra products a shopper can add to their order (like antennas or
  knobs), and hides any that don't work with the radio version they picked.
  Anything not tied to a specific version always stays visible.

  The list below matches each version of the radio to which extra products
  are allowed with it, so the page can update instantly when the shopper
  switches versions - no reload, no waiting on the server.
{% endcomment %}
{%- capture accessory_ids_by_variant -%}
  {
    {%- for variant in product.variants -%}
      {%- capture ids_json -%}{% render 'custom.util.variant-data', variant: variant, namespace: 'custom', key: 'radio_features', nested_key: 'accessories', format: 'ids' %}{%- endcapture -%}
      "{{ variant.id }}": {{ ids_json | default: '[]' }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

<script type="application/json" id="{{ script_id }}">
  {{ accessory_ids_by_variant }}
</script>

<accessory-visibility
  data-script-id="{{ script_id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-item-selector="{{ item_selector }}"
  data-id-selector="{{ id_selector }}"
  data-id-attribute="{{ id_attribute }}"
  {% unless template.suffix == 'bundle' %}
    data-ready-callback="accessoriesDoneLoadingCallback"
  {% endunless %}
></accessory-visibility>

<script type="module">
  import 'custom.accessory-visibility';

   {% unless template.suffix == 'bundle' %}
     if (Shopify.designMode != true) {
     accessoriesJS($);
   }
   {% endunless %}
</script>

{% unless template.suffix == 'bundle' %}
  {% style %}
      /* Product Accessories */
    #accessories-modal-right .accessory-description .product__desc-features, #accessories-modal-right .accessory-description .product__desc-specs{
      display: none;
    }

    #accessories-container-heading h3 {
      font-size: 1.2em !important;
      line-height: .9em !important;
      margin-bottom: 0px !important;
      font-weight: bold;
      text-align: center;
      font-family:var(--typeBasePrimary),var(--typeBaseFallback);
    }

    #accessories-info-text {
      border-top: 2px solid var(--colorBtnPrimary);
      text-align: center;
    }

    .accessories-title, .accessories-item select, .accessories-item option {
       font-size: 14px !important;
    }

    /* CHANGED: was margin-bottom: 10px !important - that was vertical-stack
       spacing between items; horizontal layout uses gap on the container
       instead, so this becomes 0 to avoid doubling up spacing */
    .accessories-item  {
      margin-bottom: 0 !important;
    }

    .accessories-item img {
      max-width: 120px !important;
    }

    .accessories-item input {
      margin-top: 1px !important;
    }

    .accessories-item input[type=checkbox] {
       width: 20px !important;
       height: 20px !important;
    }

    .accessory-price {
       color: var(--colorBtnPrimary);
       font-weight: bold;
       font-size: 14px !important;
    }

    /* NEW: horizontal scroll strip */
    #accessories-items {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 12px;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
    }

    .accessories-item {
      flex: 0 0 200px;
    }

    .accessories-item .accessories-left {
      float: none;
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .accessories-item .accessories-right {
      float: none;
      width: 100%;
      margin-left: 2rem;
    }

    .accessories-item .accessories-img-wrapper {
      text-align: center;
    }
    /* END NEW */

    @media screen and (min-width: 769px){
      .collapsible-content__inner  #w3-product-accessories {
        margin-top: 0rem !important;
      }

      #w3-product-accessories{
        margin-top: 0.5rem !important;
        margin-bottom: 1.5rem !important;
      }
    }

    @media screen and (max-width: 768px){
      #w3-product-accessories{
        margin-top: 30px! important;
      }
    }
  {% endstyle %}
{% endunless %}
