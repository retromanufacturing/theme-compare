{%- capture accessory_ids_by_variant -%}
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": [
        {%- for accessory in variant.metafields.custom.radio_features.value.accessories.value -%}
          {{ accessory.id }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

{{ 'https://accessories.w3apps.co/js/accessories.js' | script_tag }}

<script type="module">
  import { EVENTS } from '{{ 'util.events.js' | asset_url }}';

  const accessoryIdsByVariant = {{ accessory_ids_by_variant }};
  const allRestrictedIds = [...new Set(Object.values(accessoryIdsByVariant).flat())];
  let motorAccessoryIds = accessoryIdsByVariant[{{ current_variant.id }}] || [];

  // Shared by page load and variant change — walks every accessory
  // currently in the DOM and hides/shows it based on motorAccessoryIds
  function updateAccessoryVisibility() {
    $('.accessories-item').each(function () {
      const productId = Number($(this).find('.accessory-variant-select').attr('name'));
      const isRestricted = allRestrictedIds.includes(productId);
      const isForCurrentMotor = motorAccessoryIds.includes(productId);
      $(this).toggleClass('hide', isRestricted && !isForCurrentMotor);
    });
  }

  // Fires once, after accessories.js has finished building all accessory items
  window.accessoriesDoneLoadingCallback = updateAccessoryVisibility;

  document.addEventListener(`${EVENTS.variantChange}:{{ section.id }}:{{ product.id }}`, (event) => {
    if (!event.detail.variant || event.detail.loading) return;
    motorAccessoryIds = accessoryIdsByVariant[event.detail.variant.id] || [];
    updateAccessoryVisibility();
  });

  if (Shopify.designMode != true) {
    accessoriesJS($);
  }
</script>

{% style %}
  /* Product Accessories */
#accessories-modal-right .accessory-description .product__desc-features, #accessories-modal-right .accessory-description .product__desc-specs{ 
  display: none;
}     
    
