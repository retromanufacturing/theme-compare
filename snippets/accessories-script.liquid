{% comment %}
  Accessories widget (W3 Product Accessories) with motor-based filtering.

  Not every accessory in the widget is motor-specific — only ones referenced
  by a variant's radio_features metaobject accessories field are restricted.
  Anything not referenced anywhere always shows.

  accessory_ids_by_variant maps every variant on this product to its list of
  allowed accessory product IDs, so the browser can re-filter on variant
  change without a page reload or another server request.
{% endcomment %}
{%- capture accessory_ids_by_variant -%}
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": [
        {%- for accessory in variant.metafields.custom.radio_features.value.accessories.value -%}
          {{ accessory.id }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
{%- endcapture -%}

<script type="module">
  import { EVENTS } from '{{ 'util.events.js' | asset_url }}';

  // Every variant's allowed accessory IDs, built server-side above
  const accessoryIdsByVariant = {{ accessory_ids_by_variant }};

  // Every accessory ID that's restricted to at least one variant.
  // If an accessory isn't in this set, it's not part of the motor
  // system at all and should never be hidden.
  const allRestrictedIds = [...new Set(Object.values(accessoryIdsByVariant).flat())];

  // The allowed list for whichever variant is currently selected.
  // Reassigned on variant change below.
  let motorAccessoryIds = accessoryIdsByVariant[{{ current_variant.id }}] || [];

  // Walks every accessory currently in the DOM and hides/shows it based on
  // motorAccessoryIds. Shared by page load and variant change so the
  // hide/show rule only lives in one place.
  function updateAccessoryVisibility() {
    $('.accessories-item').each(function () {
      const productId = Number($(this).find('.accessory-variant-select').attr('name'));
      const isRestricted = allRestrictedIds.includes(productId);
      const isForCurrentMotor = motorAccessoryIds.includes(productId);
      $(this).toggleClass('hide', isRestricted && !isForCurrentMotor);
    });
  }

  // accessories.js calls this once, after all accessory items have been
  // built and added to the page — this covers initial page load.
  window.accessoriesDoneLoadingCallback = updateAccessoryVisibility;

  // Fires whenever the shopper selects a different variant. Re-derives the
  // allowed list for the new variant, then re-runs the same visibility
  // check against the accessory items already in the DOM.
  document.addEventListener(`${EVENTS.variantChange}:{{ section.id }}:{{ product.id }}`, (event) => {
    if (!event.detail.variant || event.detail.loading) return;
    motorAccessoryIds = accessoryIdsByVariant[event.detail.variant.id] || [];
    updateAccessoryVisibility();
  });

  if (Shopify.designMode != true) {
    accessoriesJS($);
  }
</script>

{% style %}
  /* Product Accessories */
#accessories-modal-right .accessory-description .product__desc-features, #accessories-modal-right .accessory-description .product__desc-specs{ 
  display: none;
}     
    
#accessories-container-heading h3 {
  font-size: 1.2em !important;
  line-height: .9em !important;
  margin-bottom: 0px !important;
  font-weight: bold;
  text-align: center;
  font-family:var(--typeBasePrimary),var(--typeBaseFallback);
}
    
#accessories-info-text {
  border-top: 2px solid var(--colorBtnPrimary);
  text-align: center;
}    

.accessories-title, .accessories-item select, .accessories-item option {
   font-size: 14px !important;
}

/* CHANGED: was margin-bottom: 10px !important - that was vertical-stack
   spacing between items; horizontal layout uses gap on the container
   instead, so this becomes 0 to avoid doubling up spacing */
.accessories-item  {  
  margin-bottom: 0 !important;
} 

.accessories-item img {  
  max-width: 120px !important;
} 

.accessories-item input {  
  margin-top: 1px !important;
}     
    
.accessories-item input[type=checkbox] {
   width: 20px !important;
   height: 20px !important;
}  

.accessory-price {
   color: var(--colorBtnPrimary);
   font-weight: bold;
   font-size: 14px !important;
} 

/* NEW: horizontal scroll strip */
#accessories-items {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 12px;
  padding-bottom: 8px;
  -webkit-overflow-scrolling: touch;
}

.accessories-item {
  flex: 0 0 200px;
}

.accessories-item .accessories-left {
  float: none;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.accessories-item .accessories-right {
  float: none;
  width: 100%;
}

.accessories-item .accessories-img-wrapper {
  text-align: center;
}
/* END NEW */

@media screen and (min-width: 769px){
  .collapsible-content__inner  #w3-product-accessories {
    margin-top: 0rem !important;
  }
  
  #w3-product-accessories{
    margin-top: 0.5rem !important;
    margin-bottom: 1.5rem !important;
  }
}  

@media screen and (max-width: 768px){
  #w3-product-accessories{
    margin-top: 30px! important;
  }
}   
{% endstyle %}