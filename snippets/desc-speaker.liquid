  {%- when 'R-352N' -%}
    {% render 'desc-r352n', speaker_location: speaker_location %}
  {%- when 'R-TB8' -%}
    {% render 'desc-rtb8', speaker_location: speaker_location %}
  {% else %}
    {{ product.description }}
{%- endcase -%}