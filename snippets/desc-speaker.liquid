
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign install_location = product.metafields.features.install_location
-%}

{% capture ymm %}{{ product.metafields.ymm.year }} {{ product.metafields.ymm.make }} {{ product.metafields.ymm.model }}{% endcapture %}

{% capture install_details %}
  {% if install_location != blank %}
  <tr>
    <td>Install Location</td>
    <td>{{ install_location | metafield_text }}</td>
  </tr>
  {% endif %}
{% endcapture %}

 {%- case current_variant.sku -%}
  {%- when 'R-693N' -%}
    {% render 'desc-r693n', install_details: install_details %}
  {%- when 'R-410N' -%}
    {% render 'desc-r410n', install_details: install_details %}
  {%- when 'R-525N' -%}
    {% render 'desc-r525n', install_details: install_details %}
  {%- when 'D-412UK' -%}
    {% render 'desc-d412uk', install_details: install_details %}
  {%- when 'R-69UK' -%}
    {% render 'desc-r69uk', install_details: install_details %}
  {%- when 'R-652N' -%}
    {% render 'desc-r652n' %}
  {%- when 'S-62' -%}
    {% render 'desc-s62' %}
  {%- when 'D-52UK' -%}
    {% render 'desc-d52uk' %}
  {%- when 'S-412' -%}
    {% render 'desc-s412' %}
  {%- when 'D-572UK' -%}
    {% render 'desc-d572uk' %}
  {%- when 'R-483N' -%}
    {% render 'desc-r483n' %}
  {%- when 'S-42' -%}
    {% render 'desc-s42' %}
  {%- when 'R-65UK' -%}
    {% render 'desc-r65uk' %}
  {%- when 'R-57UK' -%}
    {% render 'desc-r57uk' %}
  {%- when 'VWMSB6' -%}
    {% render 'desc-vwmsb6' %}
  {%- when 'R-410N-SB01' -%}
