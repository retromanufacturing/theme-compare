{%- liquid
  assign current_variant = product.selected_or_first_available_variant 
  assign product_features = product.metafields.description.features.value

  capture features
    for feature in product_features
        render 'item-lists', list_content: feature
    endfor
  endcapture
-%}

{% if features != blank %}
  <product-features data-product-id="{{ product.id }}" data-section-id="{{ section.id }}">
    <div class="product__features">
      <ul class="product__features-content">
        {{ features }}
      </ul>
      
      {% comment %} {% if block.settings.product_logos %}
       <div class="product__features-logos">
         {% render 'product-logos', block: block, current_variant: current_variant, motor_class: motor_class %}
       </div>
      {% endif %} {% endcomment %}
    </div>
  </product-features>
{% endif %}

{{  block.id }}