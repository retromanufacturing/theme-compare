{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign radio_features = current_variant.metafields.product_data.radio_features.value
-%}

{%- if radio_features != blank -%}
  <ul>
    {%- for feature in radio_features.features.value -%}
      <li>{{ feature }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}