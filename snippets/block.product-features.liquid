{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_features = product.metafields.description.features.value
  assign variant_features = current_variant.metafields.description.features.value
  assign radio_features = current_variant.metafields.custom.radio_features.value

 
-%}

{%- if radio_features != blank -%}
  <ul>
    {%- for feature in radio_features.features.value -%}
      <li>{{ feature }}</li>
      {% render 'block.lists', list_content: feature %}
    {%- endfor -%}
  </ul>
{%- endif -%}

