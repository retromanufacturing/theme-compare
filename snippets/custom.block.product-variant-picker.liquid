{%- liquid
  assign product = section.settings.product | default: product

  capture legacy_swatch_triggers
    render 'utility.translate', key: 'trigger.color_swatch', fallback: 'color'
  endcapture
  assign legacy_swatch_triggers = legacy_swatch_triggers | downcase | strip
  if legacy_swatch_triggers == 'color'
    assign legacy_swatch_triggers = 'color,colour'
  endif

  assign size_chart_option_list = block.settings.size_chart_option | downcase | split: ','
  assign size_chart_matched_option = blank
  for option in product.options_with_values
    assign option_name_match = option.name | downcase
    for size_chart_name in size_chart_option_list
      assign size_chart_name_match = size_chart_name | strip
      if size_chart_name_match != blank and option_name_match == size_chart_name_match
        assign size_chart_matched_option = option.name
        break
      endif
    endfor
    if size_chart_matched_option != blank
      break
    endif
  endfor

  assign size_chart_label = block.settings.size_chart_label
  assign variant_swatches = block.settings.variant_swatches
-%}

{%- comment -%}
  The size chart rides in the matched option's legend — kit.product-variant-picker
  attaches `legend_extra` to the one option named by `legend_extra_option`.
{%- endcomment -%}
{%- if block.settings.size_chart != blank and size_chart_matched_option != blank -%}
  {%- capture size_chart_title -%}
    {{ size_chart_label }}
    {%- render 'element.icon', name: 'size-chart' -%}
  {%- endcapture -%}

  {%- capture size_chart_trigger -%}
    {%- render 'overlay.tool-tip.trigger',
      title: size_chart_title,
      content: block.settings.size_chart.content,
      context: 'size-chart'
    -%}
  {%- endcapture -%}
{%- endif -%}

<div {{ block.shopify_attributes }}>
  {% if variant_swatches != blank %}
    {% render 'custom.kit.product-variant-picker',
      product: product,
      picker_type: block.settings.picker_type,
      show_labels: block.settings.variant_labels,
      enable_swatches: block.settings.color_swatches,
      update_url: update_url,
      legend_extra: size_chart_trigger,
      legend_extra_option: size_chart_matched_option,
      legacy_swatch_triggers: legacy_swatch_triggers,
      legacy_swatch_source: 'files',
      variant_swatches: variant_swatches
    %}
  {% else %}
    {% render 'kit.product-variant-picker',
      product: product,
      picker_type: block.settings.picker_type,
      show_labels: block.settings.variant_labels,
      enable_swatches: block.settings.color_swatches,
      update_url: update_url,
      legend_extra: size_chart_trigger,
      legend_extra_option: size_chart_matched_option,
      legacy_swatch_triggers: legacy_swatch_triggers,
      legacy_swatch_source: 'files'
    %}
  {% endif %}

  {%- if size_chart_trigger != blank -%}
    <script type="module">
      import 'overlay.tool-tip.trigger';
    </script>
  {%- endif -%}

  <script type="module">
    import 'block.product-variant-picker';
  </script>
</div>
