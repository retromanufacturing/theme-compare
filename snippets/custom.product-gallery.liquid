  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Renders a product's media, including images and videos.

  @param {media} media - The media object
  @param {product} product - The product object
  @param {boolean} product_zoom_enable - Whether the product zoom is enabled
  @param {string} product_zoom_size - Size of the zoomed image
  @param {boolean} video_looping - Whether the video should loop
  @param {string} video_style - Style of the video
  @param {string} mobile_layout - Layout for mobile
  @param {string} image_size - Size of the image
  @param {string} animation - Animation for the image

  @example
  {% render 'custom.product-gallery' %}
{%- enddoc -%}

{%- liquid
  assign product = section.settings.product | default: product
  assign product_zoom_size = product_zoom_size | default: '1800x1800'
  assign sizeVariable = sizeVariable | default: 'medium-up--one-half'
  assign context = context | default: 'main-product'
  assign product_zoom_enable = product_zoom_enable | default: section.settings.product_zoom_enable, allow_false: true
  assign image_size = image_size | default: section.settings.product_image_size | default: 'square'
  assign image_position = image_position | default: section.settings.image_position | default: 'left'
  assign thumbnail_arrows = thumbnail_arrows | default: section.settings.thumbnail_arrows, allow_false: true
  assign thumbnail_height = thumbnail_height | default: section.settings.thumbnail_height | default: 'flexible'
  assign isModal = isModal | default: false
  assign media_gallery_layout = media_gallery_layout | default: section.settings.media_gallery_layout
  assign section_id = section.id
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign thumbnail_position = thumbnail_position | default: section.settings.thumbnail_position | default: 'beside'
  assign hide_variant_media = hide_variant_media | default: section.settings.hide_variant_media, allow_false: true | default: false

  assign hide_thumbnails = hide_thumbnails

  if hide_variant_media
    assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  endif
-%}

{% capture slideshow %}
  {% liquid            
    assign loading = 'eager'        
    assign animation = 'image-fade-in'  

    if context == 'main-product' and forloop.index == 1              
        # LCP image is loaded immediately               
        assign loading = false               
        assign animation = 'none'            
    endif          
%}
            
{%- render 'product.gallery.media',            
    media: media,             
    featured_media: featured_media,             
    loopIndex0: forloop.index0,             
    loopIndex: forloop.index,             
    sizes: sizes,            
    sizeVariable: sizeVariable,             
    fallback: fallback,             
    loading: loading,            
    animation: animation           
    -%}
{% endcapture %}

{% capture thumbnails %}
  these are the thumbnails
{% endcapture %}

{%- liquid
  case media_class
    when 'slideshow'
      echo slideshow
    when 'thumbnails'
      echo thumbnails
  endcase
-%}
