{% comment %}
  Snippet for custom scripts loaded on theme.liquid

  -- vehicle-search: controls the vehicle search desktop display
  -- vehicle-search: controls the vehicle search mobile widget display
{% endcomment %}
<script type="module" src="{{ 'vehicle-search.js' | asset_url }}" defer="defer"></script>
<script type="module" src="{{ 'vehicle-search-widget.js' | asset_url }}" defer="defer"></script>
<script type="module" src="{{ 'vehicle-search-fitment.js' | asset_url }}" defer="defer"></script>

{% if template.name == 'product' %}
  <script type="module" src="{{ 'custom.variant-picker-labels.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script>
  document.addEventListener('hot-reload:complete', function () {
    document.querySelectorAll('product-hot-reload script').forEach(function (oldScript) {
      const newScript = document.createElement('script');
      Array.from(oldScript.attributes).forEach((attr) => newScript.setAttribute(attr.name, attr.value));
      newScript.textContent = oldScript.textContent;
      oldScript.parentNode.replaceChild(newScript, oldScript);
    });
  });
</script>