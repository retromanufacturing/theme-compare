{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_logos = product.metafields.media.logos.value
  assign radio_logos = current_variant.metafields.custom.radio_features.value.logos.value

  capture logos
    for logo in product_logos  
        render 'element.image', img: logo.image.value, alt: logo.subtitle.value, loading: 'lazy'
    endfor
    for logo in radio_logos
      render 'element.image', img: logo.image.value, alt: logo.subtitle.value, loading: 'lazy'
    endfor
  endcapture
-%}

{%- if logos != blank -%}
  <ul>
    {{ logos }}
  </ul>
{%- endif -%}

