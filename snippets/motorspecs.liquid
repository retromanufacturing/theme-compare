        <tr class="rspec-section-hd">
          <th colspan="4">AM (EU and US Tuning Capable)</th>
        </tr>
        <tr class="rspec-data-row">
          <td>Tuning Range (USA, EUR, AUS, JAP, RUS tuning capable)</td>
          <td>530–1710 kHz</td>
          <td>530–1710 kHz</td>
          <td>530–1710 kHz</td>
        </tr>
        <tr class="rspec-data-row">
          <td>Antenna Terminal</td>
          <td>External Antenna Connector</td>
          <td>External Antenna Connector</td>
          <td>External Antenna Connector</td>
        </tr>

        <tr class="rspec-section-hd">
          <th colspan="4">General</th>
        </tr>
        <tr class="rspec-data-row">
          <td>Dimensions (radio body)</td>
          <td>3.96″W × 1.98″H × 4.30″D</td>
          <td>3.96″W × 1.98″H × 4.30″D</td>
          <td>3.96″W × 1.98″H × 4.30″D</td>
        </tr>
        <tr class="rspec-data-row">
          <td>Power Requirements</td>
          <td>11.5–14.4 V</td>
          <td>10.5–14.4 V</td>
          <td>10.5–14.4 V</td>
        </tr>
        <tr class="rspec-data-row">
          <td>Current Consumption (during operation)</td>
          <td>Max. 15A</td>
          <td>Max. 15A</td>
          <td>Max. 15A</td>
        </tr>
        <tr class="rspec-data-row">
          <td>Current Consumption (car off)</td>
          <td>3.5 mA</td>
