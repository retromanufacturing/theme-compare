        <tr class="rspec-data-row">
          <td>Output Power (@ 14.4V @ 4&#x3A9; @ 1% THD)</td>
          <td>18&#x00D7;4W RMS / 40&#x00D7;4W Max</td>
          <td>25&#x00D7;4W RMS / 45&#x00D7;4W Max</td>
          <td>25&#x00D7;4W RMS / 45&#x00D7;4W Max</td>
        </tr>
        <tr class="rspec-data-row">
