        <tr class="rspec-data-row">
          <td>AUX 1 Input (cable length 8&#x22;)</td>
          <td>&gt;300 mV / 6 k&#x3A9;</td>
          <td class="rspec-empty"></td>
          <td>&gt;300 mV / 6 k&#x3A9;</td>
        </tr>
        <tr class="rspec-data-row">
          <td>AUX 2 Input (cable length 8&#x22;)</td>
          <td class="rspec-empty"></td>
