<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  /* All rules scoped to #rspec-widget — zero leakage */

  #rspec-widget {
    --rspec-bg: #f5f3ef;
    --rspec-surface: #ffffff;
    --rspec-surface-alt: #faf9f7;
    --rspec-border: #e2ddd6;
    --rspec-text-primary: #1a1714;
    --rspec-text-secondary: #6b6259;
    --rspec-text-muted: #9e948a;
    --rspec-section-bg: #1a1714;
    --rspec-section-text: #f5f3ef;
    --rspec-radius: 12px;

    font-family: 'DM Sans', sans-serif;
    background: var(--rspec-bg);
    color: var(--rspec-text-primary);
    line-height: 1.5;
    padding: 0;
    box-sizing: border-box;
  }

  #rspec-widget *,
  #rspec-widget *::before,
  #rspec-widget *::after {
    box-sizing: border-box;
  }

  #rspec-widget .rspec-table-card {
    background: var(--rspec-surface);
    border: 1px solid var(--rspec-border);
    border-radius: var(--rspec-radius);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(26,23,20,0.06), 0 4px 16px rgba(26,23,20,0.04);
  }

  #rspec-widget .rspec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 0;
    padding: 0;
  }

  /* Column header row */
  #rspec-widget .rspec-table .rspec-col-header td {
    padding: 20px 24px;
    background: var(--rspec-surface-alt);
    border-bottom: 1px solid var(--rspec-border);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.01em;
    vertical-align: middle;
    text-align: left;
  }

  #rspec-widget .rspec-table .rspec-col-header td:first-child {
    width: 38%;
  }

  #rspec-widget .rspec-table .rspec-col-header td:not(:first-child) {
    border-left: 1px solid var(--rspec-border);
  }

  /* Model name chips — base */
  #rspec-widget .rspec-model-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  /* Per-model chip colors */
  #rspec-widget .rspec-chip-motor1 {
    background: #c19e44;
    color: #ffffff;
    border-color: #c19e44;
  }

  #rspec-widget .rspec-chip-motor2 {
    background: #294957;
    color: #ffffff;
    border-color: #294957;
  }

  #rspec-widget .rspec-chip-motor4 {
    background: #623f36;
    color: #ffffff;
    border-color: #623f36;
  }

  /* Section header rows */
  #rspec-widget .rspec-table .rspec-section-hd th {
    background: var(--rspec-section-bg);
    color: var(--rspec-section-text);
    padding: 10px 24px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: left;
  }

  /* Data rows */
  #rspec-widget .rspec-table .rspec-data-row td {
    padding: 13px 24px;
    border-bottom: 1px solid var(--rspec-border);
    vertical-align: middle;
    background: var(--rspec-surface);
    text-align: left;
  }

  #rspec-widget .rspec-table tbody tr.rspec-data-row:last-child td {
    border-bottom: none;
  }

  /* Label cell */
  #rspec-widget .rspec-table .rspec-data-row td:first-child {
    color: var(--rspec-text-secondary);
    font-size: 13px;
    font-weight: 400;
    width: 38%;
    padding-right: 32px;
    line-height: 1.45;
  }

  /* Value cells */
  #rspec-widget .rspec-table .rspec-data-row td:not(:first-child) {
    font-family: 'DM Mono', monospace;
    font-size: 12.5px;
    color: var(--rspec-text-primary);
    font-weight: 400;
    border-left: 1px solid var(--rspec-border);
  }

  /* Alternating rows */
  #rspec-widget .rspec-table .rspec-data-row:nth-child(even) td {
    background: var(--rspec-surface-alt);
  }

  /* Hover */
  #rspec-widget .rspec-table .rspec-data-row:hover td {
    background: #f0ece6;
    transition: background 0.12s ease;
  }

  /* Empty / dash cells */
  #rspec-widget .rspec-table .rspec-empty::after {
    content: "—";
    color: var(--rspec-text-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
  }

  /* Responsive */
  @media (max-width: 640px) {
    #rspec-widget .rspec-table .rspec-data-row td {
      padding: 11px 14px;
    }

    #rspec-widget .rspec-table .rspec-data-row td:first-child {
      font-size: 12px;
      width: 34%;
      padding-right: 14px;
    }

    #rspec-widget .rspec-table .rspec-data-row td:not(:first-child) {
      font-size: 11px;
    }

    #rspec-widget .rspec-table .rspec-col-header td {
      padding: 16px 14px;
    }

    #rspec-widget .rspec-table .rspec-section-hd th {
      padding: 9px 14px;
    }
  }
</style>
</head>
<body>

<div id="rspec-widget">
  <div class="rspec-table-card">
    <table class="chart__radio-specs rspec-table">
      <tbody>

        <tr class="chart__radio-specs rspec-col-header">
