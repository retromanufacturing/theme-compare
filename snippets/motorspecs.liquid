        <tr class="rspec-data-row">
          <td>USB 1 Input (cable length 16&#x22;)</td>
          <td class="rspec-empty"></td>
          <td>5V (USB female input)</td>
          <td>5V (USB female input)</td>
        </tr>
        <tr class="rspec-data-row">
          <td>USB 2 Input</td>
