{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.
  Render a variant option as an accordion tab, with legend content (including
  size chart tooltip and color label) used as the accordion title.

  @param {product_option} [option] - Product option object
  @param {number} [prev_block_index] - Index of the previous block
  @param {forloop} [forloop] - Parent loop object
  @param {product} [product] - Product object
  @param {block} [block] - Block object
  @param {string} [swatch_file_extension] - Swatch file extension
  @param {boolean} [is_open] - Whether the accordion starts open

  @example
  {% render 'block.product-variant-picker.tabs', option: option, is_open: forloop.first %}
{% enddoc %}

{%- liquid
  assign product = section.settings.product | default: product
  assign variants_available_arr = product.variants | map: 'available'
  assign variants_option1_arr = product.variants | map: 'option1'
  assign variants_option2_arr = product.variants | map: 'option2'
  assign variants_option3_arr = product.variants | map: 'option3'

  assign form_id = 'product-form-' | append: section.id

  if block.settings.color_swatches
    assign is_color = false

    capture swatch_trigger
      render 'utility.translate', key: 'trigger.color_swatch', fallback: 'color'
    endcapture
    assign swatch_trigger = swatch_trigger | downcase | strip

    assign downcased_option = option.name | downcase
    if downcased_option contains swatch_trigger
      assign is_color = true
    elsif swatch_trigger == 'color' and downcased_option contains 'colour'
      assign is_color = true
    endif
  endif

  assign swatch_file_extension = swatch_file_extension | default: 'png'

  assign is_size = false

  capture size_trigger
    render 'utility.translate', key: 'labels.size_chart', fallback: 'size chart'
  endcapture
  assign size_trigger = size_trigger | downcase

  assign connect_to_sizechart = false
  assign prev_block = section.blocks[prev_block_index]
  if size_trigger contains downcased_option
    assign is_size = true
  endif
  if prev_block.type == 'size_chart' and product.has_only_default_variant == false
    assign connect_to_sizechart = true
  endif
  capture size_chart_title
    echo 'labels.size_chart' | t
    render 'element.icon', name: 'size-chart'
  endcapture

  assign is_open = is_open | default: false, allow_false: true
  assign show_features = show_features
  assign use_labels = use_labels | default: false, allow_false: true
-%}

{%- capture accordion_title -%}
  <div class="label variant__label {% unless block.settings.variant_labels %}visually-hidden{% endunless %}">
    {{ option.name }}
    {%- if connect_to_sizechart and is_size -%}
      <span class="variant__label-info">
        &mdash;
        {%- render 'overlay.tool-tip.trigger',
          title: size_chart_title,
          content: prev_block.settings.size_chart.content,
          context: 'size-chart'
        -%}
      </span>
    {%- endif -%}
    {%- if is_color -%}
      <span class="variant__label-info">
        &mdash;
        <span data-variant-color-label>
          {{ option.selected_value }}
        </span>
      </span>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture accordion_content -%}
{%- if use_labels -%}<div class="variant-input-wrap__tabs">{%- endif -%}
  {%- for value in option.values -%}
    {%- liquid
      assign option_disabled = true

      if block.settings.product_dynamic_variants_enable
        for option1_name in variants_option1_arr
          case option.position
            when 1
              if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                assign option_disabled = false
              endif
            when 2
              if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                assign option_disabled = false
              endif
            when 3
              if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                assign option_disabled = false
              endif
          endcase
        endfor
      else
        assign option_disabled = false
      endif

      assign id = section.id | append: '-' | append: product.id | append: '-' | append: option.position | append: '-' | append: forloop.index0

      if is_color
        assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
        assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
        assign color_swatch_fallback = value | split: ' ' | last | handle
      endif

      assign radio_checked = false
      if option.selected_value == value
        assign radio_checked = true
      endif

      assign radio_value = value | escape

      assign bg_color = color_swatch_fallback
      assign bg_color_image = color_image

      if value.swatch.color
        assign bg_color = value.swatch.color
      endif

      if value.swatch.image
        assign bg_color_image = value.swatch.image | image_url: width: 50
      endif

      assign variant_details = nil
      assign value_scheme = nil
      if use_labels
        assign variant_details = value.variant.metafields.custom.radio_features.value.variant_details.value | first
        if variant_details == blank
          assign variant_details = value.variant.metafields.custom.variant_details.value
        endif
        if block.settings.enable_colored_options
          assign value_scheme_key = 'color_scheme_option_value_' | append: forloop.index0
          assign value_scheme = block.settings[value_scheme_key]
        endif
      endif
    -%}

    {%- capture button_text -%}
      {{ value | escape}}
      {%- if option_disabled -%}
        <span class="visually-hidden">
          {% render 'utility.translate',
            key: 'info.variant_sold_out_or_unavailable',
            fallback: 'Variant sold out or unavailable'
          %}
        </span>
      {%- endif -%}
    {%- endcapture -%}

    {%- capture radio_label -%}
      {%- render 'element.button', type: 'button', text: button_text, inverted: true, style: '--element-button-color-primary: var(--color-primary); --element-button-color-secondary: var(--color-secondary);' -%}
    {%- endcapture -%}

    {%- if is_color -%}
      {%- capture swatch_style -%}
        --element-swatch-color-background: {{ bg_color }};
        --element-swatch-color-background-image: url({{ bg_color_image }});
      {%- endcapture -%}

      {%- capture radio_label -%}
        {%- render 'element.swatch', large: true, style: swatch_style, disabled: option_disabled -%}

        <span class="visually-hidden">
          {{ value | escape }}
        </span>

        {%- if option_disabled -%}
          <span class="visually-hidden">
            {% render 'utility.translate',
              key: 'info.variant_sold_out_or_unavailable',
              fallback: 'Variant sold out or unavailable'
            %}
          </span>
        {%- endif -%}
      {%- endcapture -%}
    {%- endif -%}

    {%- if use_labels and variant_details != blank -%}
      {%- capture radio_label -%}
        {%- render 'block.product-variant-picker.label.custom',
          value: value,
          variant_details: variant_details,
          option_disabled: option_disabled,
          value_scheme: value_scheme,
          block: block
        -%}
      {%- endcapture -%}
    {%- endif -%}

    {%- capture radio_attributes -%}
      form="{{ form_id }}"
      data-index="option{{ option.position }}"
    {%- endcapture -%}

    {%- assign radio_classlist = '' -%}
    {% if option_disabled %}
      {%- assign radio_classlist = 'disabled' -%}
    {% endif %}

    {%- if use_labels -%}
  <div class="variant-input"
    {% if value_scheme %}
      style="--variant-color-primary: {{ value_scheme.settings.primary }}; --variant-color-secondary: {{ value_scheme.settings.secondary }};"
    {% endif %}
  >
    {%- render 'element.radio',
      id: id,
      name: option.name,
      value: radio_value,
      label: radio_label,
      classlist: radio_classlist,
      attributes: radio_attributes,
      checked: radio_checked,
      display_icon: false,
      slot: radio_label
    -%}
  </div>
{%- else -%}
    {%- render 'element.radio',
      id: id,
      name: option.name,
      value: radio_value,
      label: radio_label,
      classlist: radio_classlist,
      attributes: radio_attributes,
      checked: radio_checked,
      display_icon: false,
      slot: radio_label
    -%}
  {%- endif -%}  
  {%- endfor -%}
   {%- if use_labels -%}</div>{%- endif -%}
  {% if show_features %}    
    <div class="product-features-wrap">
      {% liquid 
        capture content          
          render 'block.product-features', product: closest.product | default: product, block: block          
          render 'block.product-logos', block: block, product: closest.product, logo_sizing: block.settings.logo_sizing, logo_custom_height: block.settings.logo_custom_height        
        endcapture
      
        render 'custom.variant-block', content: content, block: block, product: closest.product | default: product    
      %}
    </div>
  {% endif %}
 
{%- endcapture -%}

<fieldset class="variant-button-wrap">
  {%- render 'element.accordion', title: accordion_title, slot: accordion_content, open: is_open -%}
</fieldset>

{% stylesheet %}
  .product-features-wrap {
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
    border-radius: 16px;
    border: 1px solid #ddd;
    width: fit-content;
  }
  .variant-input .element-radio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    border-radius: 1rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .variant-input-wrap__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }

  .variant-input-wrap__tabs .variant-input {
    flex: 1 1 0;
    margin: 0;
  }

  .variant-input .element-radio:has(input:checked) {
    border: 2.5px solid #fff;
    outline-offset: 1px;
    transform: translateY(-2px) scale(1.03);
    position: relative;
    z-index: 1;
  }
{% endstylesheet %}

{% style %}
      {% if block.settings.enable_colored_options %}
      .variant-input .element-radio {
        background-color: var(--variant-color-secondary);
        color: var(--variant-color-primary);
        font-weight: 700;
        padding: 7px 15px;
      }

      .variant-input .element-radio:has(input:checked) {
        outline: 2.5px solid var(--variant-color-secondary);
        box-shadow: 0 0 0 3px var(--variant-color-secondary), 0 4px 14px rgba(0,0,0,0.25);
      }
  {% endif %}
{% endstyle %}
