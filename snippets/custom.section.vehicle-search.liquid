<ul class="dropdowns ymm_grid">
  <li class="ymm-label {{ grid_layout }}">
    <select
      class="ymm-filter js-ymm--year js-ymm-filter"
      id="{{ id }}--year"
      data-fitment
      data-fitment-id="{{ id }}"
      data-fitment-type="year"
    ></select>
  </li>
  <li class="ymm-label {{ grid_layout }}">
    <select
      class="ymm-filter js-ymm--make js-ymm-filter"
      id="{{ id }}--make"
      data-fitment
      data-fitment-id="{{ id }}"
      data-fitment-type="make"
      disabled="disabled"
    ></select>
  </li>
  <li class="ymm-label {{ grid_layout }}">
    <select
      class="ymm-filter js-ymm--model js-ymm-filter"
      id="{{ id }}--model"
      data-fitment
      data-fitment-id="{{ id }}"
      data-fitment-type="model"
      disabled="disabled"
    ></select>
  </li>
</ul>

