<style>
/* Motor styling */
.rm-motor-wrap {
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 14px 22px;
  font-family: Arial, sans-serif;
  color: #1b1b1b;
}

.rm-motor-card {
  border: 1px solid rgba(0,0,0,.12);
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 26px rgba(0,0,0,.08);
  margin: 14px 0;
  background: #fff;
}

.rm-motor-head-1b {
  padding: 14px 16px;
  background: #bc9923;
  color: #fff;
}

.rm-motor-head-1dab {
  padding: 14px 16px;
  background: #bc9923;
  color: #fff;
}

.rm-motor-head-2b {
  padding: 14px 16px;
  background: #1d3748;
  color: #fff;
}

.rm-motor-head-2dab {
  padding: 14px 16px;
  background: #1d3748;
  color: #fff;
}

.rm-motor-head-4hd {
  padding: 14px 16px;
  background: #5d3324;
  color: #fff;
}

.rm-motor-head-6 {
  padding: 14px 16px;
  background: #2c5f2d;
  color: #fff;
}

.rm-motor-head-1b h3,
.rm-motor-head-1dab h3,
.rm-motor-head-2b h3,
.rm-motor-head-2dab h3,
.rm-motor-head-4hd h3,
.rm-motor-head-6 h3 {
  margin: 0;
  margin-bottom: 5px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: .2px;
}

.rm-motor-sub {
  margin: 6px 0 0;
  font-size: 13px;
  opacity: .9;
  font-weight: 600;
}

.rm-motor-body {
  padding: 14px 16px 16px;
}

.rm-motor-body p {
  margin: 0 0 10px;
  line-height: 1.45;
}

.rm-motor-feats {
  margin: 10px 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 14px;
}

.rm-motor-feats li {
  margin: 0;
  padding-left: 22px;
  position: relative;
  line-height: 1.35;
}

.rm-motor-feats li:before {
  content: "✓";
  position: absolute;
  left: 0;
  top: 0;
  color: #0a7a2f;
  font-weight: 900;
}

.rm-motor-note {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(129,15,18,.08);
  border: 1px solid rgba(129,15,18,.18);
  color: #2a2a2a;
  font-size: 13px;
  line-height: 1.35;
}

@media (max-width: 640px) {
  .rm-motor-feats {
    grid-template-columns: 1fr;
  }
}
</style>

{% if DAB %}
