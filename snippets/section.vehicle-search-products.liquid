<fitment-product-grid data-limit="{{ block.settings.product_count }}" {{ block.shopify_attributes }}>
   {%- capture header_content -%}
    {%- if block.settings.heading != blank -%}
      <h2 class="rte--block rte--strong">
        {{ block.settings.heading }}
      </h2>
    {%- endif -%}
    {%- render 'element.button', href: '#', text: block.settings.button_text, classlist: 'fitment-view-all' -%}
  {%- endcapture -%}

  {%- render 'layout.stack', slot: header_content, horizontal: true, justify: 'space-between', align: 'center' -%}

  <div class="fitment-product-grid__results"></div>
  
</fitment-product-grid>

<script type="module">
  import 'custom.vehicle-search-products';
</script>
