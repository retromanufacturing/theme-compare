{%- liquid
  assign watched_tags = section.settings.filter_tags | downcase | split: ', '
  assign matching_tags = ''

  if product
    for tag in watched_tags
      assign tag = tag | strip
      for product_tag in product.tags
        assign downcased_product_tag = product_tag | downcase
        if downcased_product_tag == tag
          assign matching_tags = matching_tags | append: tag | append: ', '
        endif
      endfor
    endfor
  endif
-%}

<fitment-product-grid
  class="index-section{% unless section.settings.space_above %} no-space-top{% endunless %}{% unless section.settings.space_below %} no-space-bottom{% endunless %}"
  data-limit="{{ section.settings.product_count }}"
  data-match-tags="{{ matching_tags | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    {%- capture header_content -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rte--section rte--strong">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- render 'element.button', href: '#', text: section.settings.button_text, classlist: 'fitment-view-all' -%}
  {%- endcapture -%}

    {%- render 'layout.stack', slot: header_content, horizontal: true, justify: 'space-between', align: 'center' -%}

    <div class="fitment-product-grid__results"></div>
  </div>
</fitment-product-grid>

<script type="module">
  import 'custom.vehicle-search-products';
</script>

{% stylesheet %}
  /* Keeps the heading with fitment hidden until products and fitment loaded*/
    fitment-product-grid:not([data-ready]) {
      visibility: hidden;
    }

    .index-section.no-space-top {
      margin-top: 0;
      padding-top: 0;  
    }

    .index-section.no-space-bottom {
      margin-bottom: 0;
      padding-bottom: 0;
    }
{% endstylesheet %}
