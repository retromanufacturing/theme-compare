{% doc %}
  Renders enhanced label content for a variant option value when use_labels is enabled.
  Displays name, badge, and subtitle from variant_details metaobject.
  Optionally applies color scheme styling when enable_colored_options is true.

  @param {object} value - The option value object
  @param {object} variant_details - Resolved variant_details metaobject entry
  @param {boolean} option_disabled - Whether this option value is disabled
  @param {object} value_scheme - Color scheme object for this value (optional)
  @param {object} block - Block object
{% enddoc %}

{%- liquid
  assign label_name = variant_details.name.value | default: value
  assign label_badge = variant_details.badge.value
  assign label_subtitle = variant_details.description.value
-%}

<span class="variant__tab-label-main">
  {{ label_name }}
  {%- if label_badge != blank -%}
    <span class="variant__tab-badge">{{ label_badge }}</span>
  {%- endif -%}
</span>
{%- if label_subtitle != blank -%}
  <span class="variant__tab-label-subtitle">{{ label_subtitle }}</span>
{%- endif -%}
{%- if option_disabled -%}
  <span class="visually-hidden">
    {% render 'utility.translate',
      key: 'info.variant_sold_out_or_unavailable',
      fallback: 'Variant sold out or unavailable'
    %}
  </span>
{%- endif -%}

{% style %}
  .variant__tab-label-main {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .variant__tab-badge {
    font-size: 0.68rem;
    padding: 0px 4px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.45);
    background: rgba(0,0,0,0.15);
    display: inline-block;
    margin-left: 4px;
    color: #fff;
    white-space: nowrap;
  }

  .variant__tab-label-subtitle {
    display: block;
    font-size: 0.75em;
    font-weight: normal;
    opacity: 0.75;
    line-height: 1.3;
    margin-top: 2px;
  }
{% endstyle %}