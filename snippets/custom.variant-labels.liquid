{% doc %}
  Variant tier label content, dispatched by `part`. Resolves radio_features
  metaobject data from the option value's matching variant.

  @param {string} part - 'text' or 'style'
  @param {object} value - product_option_value object
  @param {boolean} [use_labels] - Whether to resolve/render tier data. Default: false
  @param {string} [value_name_escaped] - Fallback display name if no override exists
{% enddoc %}

{%- liquid
  assign variant_name = value_name_escaped
  assign tier_color = nil
  assign variant_badge = nil
  assign variant_description = nil

  if use_labels
    assign radio_features = value.variant.metafields.custom.radio_features.value
    assign tier_color = radio_features.color.value
    assign variant_details = radio_features.variant_details.value | first
    if variant_details == blank
      assign variant_details = value.variant.metafields.custom.variant_details.value
    endif
    assign variant_name = variant_details.name.value | default: value_name_escaped
    assign variant_badge = variant_details.badge.value
    assign variant_description = variant_details.description.value
  endif
-%}

{%- case part -%}
  {%- when 'text' -%}
    <span class="variant__tab-label-main">
      {{ variant_name }}
      {%- if variant_badge != blank -%}
        <span class="variant__tab-badge">{{ variant_badge }}</span>
      {%- endif -%}
    </span>
    {%- if variant_description != blank -%}
      <span class="variant__tab-label-subtitle">{{ variant_description }}</span>
    {%- endif -%}

  {%- when 'style' -%}
    {%- if tier_color != blank -%}
      --variant-color-secondary: {{ tier_color }};
      --variant-color-primary: #fff;
    {%- endif -%}
{%- endcase -%}

{% stylesheet %}
  .variant__tab-label-main {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .variant__tab-badge {
    font-size: 0.68rem;
    padding: 0px 4px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.45);
    background: rgba(0,0,0,0.15);
    display: inline-block;
    margin-left: 4px;
    color: #fff;
    white-space: nowrap;
  }

  .variant__tab-label-subtitle {
    display: block;
    font-size: 0.75em;
    font-weight: normal;
    opacity: 0.75;
    line-height: 1.3;
    margin-top: 2px;
  }
{% endstylesheet %}