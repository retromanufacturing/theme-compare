  .site-header__cart--slideout {
  position: fixed;
  top: 0;
  right: 0;
  left: auto;
  bottom: 0;
  width: min(480px, 100vw);
  max-height: 100dvh;
  overflow-y: hidden;
  padding: 0;
  transform: translateX(100%);
  display: none;
}

  .site-header__cart--slideout .site-header__drawer-animate {
    display: flex;
    flex-direction: column;
    height: 100%;
    transform: none;
    opacity: 1;
    transition: none;

    .is-active & {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }

  .site-header__cart--slideout .cart__drawer-form {
    max-height: 100dvh;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .site-header__cart--slideout .cart__scrollable {
    flex: 1 1 auto;
    overflow-y: auto;
  }

  .site-header__cart--slideout .cart__footer {
    flex-shrink: 0;
  }

  header-section.cart-open:has(.site-header__cart--slideout) .site-nav__icons {
    display: flex;
  }
{% endstylesheet %}

{%- capture cart_content -%}
  {%- render 'header.cart-drawer', cart_type: 'slideout' -%}
{%- endcapture -%}

{%- render 'header.drawer',
  slot: cart_content,
  open: 'cart:open',
  close: 'cart:close',
  class: 'site-header__cart site-header__cart--slideout'
-%}