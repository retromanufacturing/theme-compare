{% doc %}
  header.cart-slideout.liquid
  Place in: /snippets/header.cart-slideout.liquid

  Slideout cart using header.drawer as the container, positioned as a
  full-height side panel via CSS overrides. Uses header.cart-drawer content
  with cart-type="dropdown" so HeaderCart fires EVENTS.cartOpen after
  ajaxProductAdded, which HeaderDrawer responds to and opens the panel.

  No custom JS needed. HeaderDrawer handles all open/close behavior,
  body scroll lock, focus trap, and event firing identically to the dropdown.
{% enddoc %}

{% stylesheet %}
  .site-header__cart--slideout {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    width: min(400px, 100vw);
    max-height: 100dvh;
    overflow-y: hidden;
    padding: 0;
    transform: translateX(100%);
    transition: transform var(--slide-curve);

    @media only screen and (max-width: 768px) {
      width: 100vw;
    }

    &.is-active {
      display: flex;
      flex-direction: column;
      transform: translateX(0);
    }
  }

  .site-header__cart--slideout .site-header__drawer-animate {
    display: flex;
    flex-direction: column;
    height: 100%;
    transform: none;
    opacity: 1;
    transition: none;
  }

  .site-header__cart--slideout.is-active .site-header__drawer-animate {
    transform: none;
    opacity: 1;
    transition: none;
  }

  .site-header__cart--slideout .cart__drawer-form {
    max-height: 100dvh;
    height: 100%;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .site-header__cart--slideout .cart__scrollable {
    flex: 1 1 auto;
    overflow-y: auto;
  }

  .site-header__cart--slideout .cart__footer {
    flex-shrink: 0;
  }
{% endstylesheet %}

{%- render 'header.cart-drawer', cart_type: 'dropdown' -%}