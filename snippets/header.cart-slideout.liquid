{% doc %}
  header.cart-slideout.liquid
  Place in: /snippets/header.cart-slideout.liquid
{% enddoc %}

{% stylesheet %}
  .cart-slideout .cart__drawer-form {
    max-height: 100dvh;
    height: 100%;
  }

  .cart-slideout .cart__scrollable {
    flex: 1 1 auto;
  }

  .cart-slideout .cart__footer {
    flex-shrink: 0;
  }
{% endstylesheet %}

{%- capture cart_content -%}
  {%- render 'header.cart-drawer', cart_type: 'slideout' -%}
{%- endcapture -%}

<cart-slideout class="cart-slideout">
  {%- render 'overlay.drawer',
    id: 'cart-slideout',
    label: 'Cart',
    slot: cart_content,
    placement: 'end',
    light_dismiss: true
  -%}
</cart-slideout>